    "Needed for newer games that use DirectX 12. Apple provides it for free. You can also set it up later." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Патрэбны для новых гульняў на DirectX 12. Apple дае яго бясплатна. Можна наладзіць і пазней."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für neuere Spiele mit DirectX 12 gebraucht. Apple stellt es kostenlos bereit. Sie können es auch später einrichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace falta para los juegos nuevos que usan DirectX 12. Apple lo ofrece gratis. También puedes configurarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire pour les jeux récents qui utilisent DirectX 12. Apple le fournit gratuitement. Vous pouvez aussi le configurer plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per i giochi recenti che usano DirectX 12. Apple lo offre gratis. Puoi configurarlo anche più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 12 を使う新しめのゲームに必要です。Apple が無料で提供しています。あとから設定しても構いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 12를 쓰는 최신 게임에 필요합니다. Apple이 무료로 제공합니다. 나중에 설정해도 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodig voor nieuwere games die DirectX 12 gebruiken. Apple levert het gratis. Je kunt het ook later instellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrzebny do nowszych gier na DirectX 12. Apple udostępnia go za darmo. Możesz też skonfigurować go później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para jogos novos que usam DirectX 12. A Apple oferece de graça. Você também pode configurar depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужен для новых игр на DirectX 12. Apple даёт его бесплатно. Можно настроить и позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behövs för nyare spel som använder DirectX 12. Apple tillhandahåller det gratis. Du kan också ställa in det senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 12 kullanan yeni oyunlar için gerekir. Apple bunu ücretsiz sunar. Daha sonra da ayarlayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібен для нових ігор на DirectX 12. Apple дає його безкоштовно. Можна налаштувати й пізніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 DirectX 12 的较新游戏需要它。Apple 免费提供。也可以之后再设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 DirectX 12 的較新遊戲需要它。Apple 免費提供。也可以之後再設定。"
          }
        }
      }
    },
    "Needed once for games that use DirectX 12." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Патрэбна адзін раз для гульняў на DirectX 12."
          }
        },
        "de" : {
