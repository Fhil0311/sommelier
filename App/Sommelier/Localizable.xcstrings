    "If you quit Sommelier, the game closes too. Unsaved progress is lost." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі закрыць Sommelier, гульня таксама закрыецца. Незахаваны прагрэс прападзе."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Sommelier beenden, wird auch das Spiel geschlossen. Ungesicherter Fortschritt geht verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sales de Sommelier, el juego también se cierra. Se pierde el progreso no guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
