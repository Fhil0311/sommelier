        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen för nya spel är inte tillgänglig. Anslut dess enhet eller välj en annan mapp i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
