    "Behind search, settings and dialogs. Games keep their own art." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За пошукам, наладамі і вокнамі. У гульняў застаецца іх арт."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinter Suche, Einstellungen und Dialogen. Spiele behalten ihr eigenes Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detrás de la búsqueda, los ajustes y los diálogos. Los juegos mantienen su propia imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derrière la recherche, les réglages et les dialogues. Les jeux gardent leur propre image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dietro ricerca, impostazioni e finestre. I giochi tengono la loro immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索、設定、ダイアログの背景。ゲームは各自のアートを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색, 설정, 대화상자 뒤에 표시됩니다. 게임은 자체 아트를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achter zoeken, instellingen en dialogen. Games houden hun eigen afbeeldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za wyszukiwaniem, ustawieniami i oknami dialogowymi. Gry mają własne grafiki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrás da busca, dos ajustes e dos diálogos. Os jogos mantêm a própria arte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За поиском, настройками и окнами. У игр остаётся их арт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakom sökning, inställningar och dialogrutor. Spel behåller sina egna bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama, ayarlar ve iletişim kutularının arkasında. Oyunlar kendi görsellerini korur."
          }
        },
        "uk" : {
