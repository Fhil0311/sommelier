    "New games from Epic Games, GOG and Steam install here. For Steam, Sommelier adds the folder as a Steam library and makes Steam pick it. Games already installed stay where they are." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сюды ўсталёўваюцца новыя гульні з усіх крам. Ужо ўсталяваныя застаюцца на месцы."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Spiele von Epic Games, GOG und Steam werden hier installiert. Für Steam fügt Sommelier den Ordner als Steam-Bibliothek hinzu und lässt Steam ihn verwenden. Bereits installierte Spiele bleiben, wo sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí se instalan los juegos nuevos de Epic Games, GOG y Steam. Para Steam, Sommelier añade la carpeta como biblioteca de Steam y hace que Steam la use. Los juegos ya instalados se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux jeux d'Epic Games, GOG et Steam s'installent ici. Pour Steam, Sommelier ajoute le dossier comme bibliothèque Steam et le fait choisir par Steam. Les jeux déjà installés restent où ils sont."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi giochi di Epic Games, GOG e Steam si installano qui. Per Steam, Sommelier aggiunge la cartella come libreria Steam e la fa scegliere a Steam. I giochi già installati restano dove sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic Games、GOG、Steam の新しいゲームはここにインストールされます。Steam では、Sommelier がこのフォルダを Steam ライブラリとして追加し、インストール時に選ばれるようにします。インストール済みのゲームはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic Games, GOG, Steam의 새 게임이 여기에 설치됩니다. Steam의 경우 Sommelier가 이 폴더를 Steam 라이브러리로 추가해 사용하도록 설정합니다. 이미 설치된 게임은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe games van Epic Games, GOG en Steam worden hier geïnstalleerd. Voor Steam voegt Sommelier de map toe als Steam-bibliotheek en laat Steam die gebruiken. Al geïnstalleerde games blijven waar ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu instalują się nowe gry z Epic Games, GOG i Steam. Dla Steam Sommelier dodaje ten folder jako bibliotekę Steam i ustawia go jako domyślny. Zainstalowane gry zostają na miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos jogos da Epic Games, GOG e Steam são instalados aqui. No Steam, o Sommelier adiciona a pasta como biblioteca do Steam e faz o Steam usá-la. Jogos já instalados ficam onde estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сюда ставятся новые игры из всех магазинов. Уже установленные остаются на месте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya spel från Epic Games, GOG och Steam installeras här. För Steam lägger Sommelier till mappen som ett Steam-bibliotek och låter Steam använda den. Spel som redan är installerade ligger kvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic Games, GOG ve Steam'den yeni oyunlar buraya yüklenir. Sommelier, Steam için klasörü bir Steam kitaplığı olarak ekler ve Steam'in onu seçmesini sağlar. Zaten yüklü oyunlar yerinde kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сюди встановлюються нові ігри з усіх крамниць. Уже встановлені залишаються на місці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 Epic Games、GOG 和 Steam 的新游戏会安装到这里。对于 Steam，Sommelier 会把该文件夹添加为 Steam 库并让 Steam 选用它。已安装的游戏保持原位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epic Games、GOG 和 Steam 的新遊戲會安裝在這裡。對於 Steam，Sommelier 會將此檔案夾加入為 Steam 遊戲庫，並讓 Steam 使用它。已安裝的遊戲會留在原處。"
          }
        }
      }
    },
    "Newer cloud saves come down before a game starts; newer saves from this Mac go up after it quits. Steam games sync through Steam." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як у Steam: перад запускам бярэцца самае свежае захаванне, пасля выхаду яно адпраўляецца ў воблака."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuere Cloud-Spielstände werden vor dem Spielstart geladen, neuere von diesem Mac nach dem Beenden hochgeladen. Steam-Spiele synchronisieren über Steam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las partidas más recientes de la nube se bajan antes de empezar a jugar; las más recientes de este Mac se suben al salir. Los juegos de Steam se sincronizan con Steam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes cloud plus récentes sont récupérées avant le lancement ; celles de ce Mac, si elles sont plus récentes, partent après la fermeture du jeu. Les jeux Steam se synchronisent via Steam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I salvataggi più recenti nel cloud vengono scaricati prima dell'avvio; quelli più recenti di questo Mac vengono caricati dopo la chiusura. I giochi Steam si sincronizzano tramite Steam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム開始前にクラウドの新しいセーブを取得し、終了後にこの Mac の新しいセーブを送ります。Steam のゲームは Steam が同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 시작 전에 클라우드의 최신 저장 파일을 받고, 종료 후 이 Mac의 최신 저장 파일을 올립니다. Steam 게임은 Steam이 동기화합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwere cloudsaves worden opgehaald voordat een game start; nieuwere saves van deze Mac gaan omhoog als je stopt. Steam-games synchroniseren via Steam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowsze zapisy z chmury pobierają się przed startem gry, a nowsze z tego Maca wysyłają się po jej zamknięciu. Gry ze Steam synchronizuje Steam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves mais novos da nuvem são baixados antes de o jogo abrir; saves mais novos deste Mac são enviados depois que ele fecha. Jogos do Steam sincronizam pelo Steam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как в Steam: перед запуском берётся самое свежее сохранение, после выхода оно отправляется в облако."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyare molnsparfiler hämtas innan ett spel startar, och nyare sparfiler från den här Macen laddas upp när det avslutas. Steam-spel synkas via Steam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yeni bulut kayıtları oyun başlamadan önce indirilir; bu Mac'teki daha yeni kayıtlar oyun kapanınca buluta gönderilir. Steam oyunları Steam üzerinden eşzamanlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як у Steam: перед запуском береться найсвіжіше збереження, після виходу воно вивантажується в хмару."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏启动前下载云端较新的存档，退出后上传这台 Mac 上较新的存档。Steam 游戏通过 Steam 同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲啟動前會下載較新的雲端存檔；結束後會上傳這部 Mac 上較新的存檔。Steam 遊戲透過 Steam 同步。"
          }
        }
      }
    },
