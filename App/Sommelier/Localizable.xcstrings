        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 게임에는 DirectX 12가 필요합니다. 한 번 설정하면 모든 DirectX 12 게임을 실행할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
