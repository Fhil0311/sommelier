    "To have us delete the reports instead, email this number to support@playsommelier.com." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каб справаздачы выдалілі мы, дашліце гэты нумар на support@playsommelier.com."
          }
        },
        "de" : {
          "stringUnit" : {
