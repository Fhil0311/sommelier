      }
    },
    "This version is built for Intel Macs and runs through Rosetta, which Apple ends in macOS 28." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэтая версія сабрана для Mac з Intel і працуе праз Rosetta, якую Apple прыбярэ ў macOS 28."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version ist für Intel-Macs gebaut und läuft über Rosetta, das Apple mit macOS 28 einstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión está hecha para Mac con Intel y funciona con Rosetta, que Apple retira en macOS 28."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version est conçue pour les Mac Intel et passe par Rosetta, qu'Apple supprime dans macOS 28."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione è fatta per i Mac Intel e gira tramite Rosetta, che Apple elimina con macOS 28."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンは Intel Mac 向けで、Rosetta 経由で動作します。Rosetta は macOS 28 で終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전은 Intel 기반 Mac용으로 빌드되어 Rosetta로 실행되며, Apple은 macOS 28에서 Rosetta를 종료합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze versie is gemaakt voor Intel-Macs en draait via Rosetta, waarmee Apple stopt in macOS 28."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja jest zbudowana dla Maców z procesorem Intel i działa przez Rosettę, którą Apple wycofa w macOS 28."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão foi feita para Macs Intel e roda pelo Rosetta, que a Apple vai encerrar no macOS 28."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия собрана для Intel Mac и работает через Rosetta, которую Apple уберёт в macOS 28."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här versionen är byggd för Intel-Mac och körs via Rosetta, som Apple slutar med i macOS 28."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sürüm Intel Mac'ler için derlendi ve Rosetta ile çalışır; Apple, Rosetta'yı macOS 28'de kaldırıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця версія зібрана для Mac з Intel і працює через Rosetta, яку Apple прибере в macOS 28."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本为 Intel Mac 构建，通过 Rosetta 运行；Apple 将在 macOS 28 中移除 Rosetta。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本是為 Intel 型 Mac 建構，需透過 Rosetta 執行，而 Apple 將在 macOS 28 停止支援 Rosetta。"
          }
        }
      }
    },
