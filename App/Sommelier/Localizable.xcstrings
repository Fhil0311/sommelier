    },
    "The saves on this Mac and in the cloud both changed since the last sync.\nCloud: %@\nThis Mac: %@\nThe other side is replaced." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З апошняй сінхранізацыі змяніліся і захаванні на гэтым Mac, і ў воблаку.\nВоблака: %1$@\nГэты Mac: %2$@\nІншы бок будзе заменены."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spielstände auf diesem Mac und in der Cloud haben sich seit der letzten Synchronisierung beide geändert.\nCloud: %1$@\nDieser Mac: %2$@\nDie andere Seite wird ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The saves on this Mac and in the cloud both changed since the last sync.\nCloud: %1$@\nThis Mac: %2$@\nThe other side is replaced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las partidas de este Mac y las de la nube han cambiado desde la última sincronización.\nNube: %1$@\nEste Mac: %2$@\nSe sustituirán las del otro lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes de ce Mac et du cloud ont toutes deux changé depuis la dernière synchronisation.\nCloud : %1$@\nCe Mac : %2$@\nL'autre version sera remplacée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I salvataggi su questo Mac e nel cloud sono cambiati entrambi dall'ultima sincronizzazione.\nCloud: %1$@\nQuesto Mac: %2$@\nL'altra versione verrà sostituita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の同期以降、この Mac とクラウドの両方でセーブデータが変更されました。\nクラウド: %@\nこの Mac: %@\nもう一方は置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 동기화 이후 이 Mac과 클라우드의 저장 파일이 모두 변경되었습니다.\n클라우드: %1$@\n이 Mac: %2$@\n다른 쪽은 대체됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De saves op deze Mac en in de cloud zijn allebei gewijzigd sinds de laatste synchronisatie.\nCloud: %1$@\nDeze Mac: %2$@\nDe andere kant wordt vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od ostatniej synchronizacji zmieniły się zapisy i na tym Macu, i w chmurze.\nChmura: %1$@\nTen Mac: %2$@\nDruga strona zostanie zastąpiona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os saves deste Mac e os da nuvem mudaram desde a última sincronização.\nNuvem: %1$@\nEste Mac: %2$@\nO outro lado será substituído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С последней синхронизации изменились и сохранения на этом Mac, и в облаке.\nОблако: %@\nЭтот Mac: %@\nДругая сторона будет заменена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparfilerna på den här Macen och i molnet har båda ändrats sedan senaste synkningen.\nMolnet: %1$@\nDen här Macen: %2$@\nDen andra sidan ersätts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son eşzamanlamadan bu yana hem bu Mac'teki hem de buluttaki kayıtlar değişti.\nBulut: %1$@\nBu Mac: %2$@\nDiğer taraf değiştirilecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від останньої синхронізації змінилися і збереження на цьому Mac, і в хмарі.\nХмара: %1$@\nЦей Mac: %2$@\nІнший бік буде замінено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自上次同步以来，这台 Mac 和云端的存档都有变化。\n云端：%@\n这台 Mac：%@\n另一方将被替换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自上次同步以來，這部 Mac 和雲端上的存檔都有變更。\n雲端：%1$@\n這部 Mac：%2$@\n另一邊的存檔將被取代。"
          }
        }
      }
    },
    "The settings Sommelier ran the game with" : {
      "localizations" : {
        "be" : {
