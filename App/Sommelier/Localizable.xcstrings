    "Removes the game reports and launch failures this Mac sent. Reports you send later start fresh, under a new random id." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдаляе з сервера справаздачы пра гульні і збоі, адпраўленыя з гэтага Mac. Новыя справаздачы пойдуць пад новым выпадковым нумарам."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die Spielberichte und Startfehler, die dieser Mac gesendet hat. Spätere Berichte beginnen neu, unter einer neuen zufälligen ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los informes de juegos y los fallos de arranque que envió este Mac. Los informes que envíes después empiezan de cero, con un nuevo ID aleatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les rapports de jeux et les échecs de lancement envoyés par ce Mac. Les prochains rapports repartent de zéro, avec un nouvel identifiant aléatoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina i report sui giochi e gli avvii falliti inviati da questo Mac. I prossimi report ripartono da zero, con un nuovo ID casuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac から送信したゲームのレポートと起動失敗のレポートを削除します。今後のレポートは新しいランダムな ID で送られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 보낸 게임 리포트와 실행 실패 기록을 삭제합니다. 이후 보내는 리포트는 새 임의 ID로 새로 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert de gamerapporten en startfouten die deze Mac heeft verstuurd. Latere rapporten beginnen opnieuw, onder een nieuwe willekeurige ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa raporty o grach i błędach uruchamiania wysłane z tego Maca. Kolejne raporty zaczną od nowa, pod nowym losowym ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga os relatórios de jogos e as falhas de abertura que este Mac enviou. Relatórios futuros começam do zero, com um novo ID aleatório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет с сервера отчёты об играх и сбоях, отправленные с этого Mac. Новые отчёты пойдут под новым случайным номером."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderar spelrapporterna och startfelen som den här Macen har skickat. Rapporter du skickar senare börjar om med ett nytt slumpmässigt id."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac'in gönderdiği oyun raporlarını ve açılış hatalarını siler. Sonra göndereceğiniz raporlar yeni bir rastgele kimlikle sıfırdan başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє із сервера звіти про ігри й збої, надіслані з цього Mac. Нові звіти підуть під новим випадковим номером."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除这台 Mac 发送的游戏报告和启动失败报告。之后发送的报告将使用新的随机编号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除這部 Mac 傳送過的遊戲報告和啟動失敗記錄。之後傳送的報告會以新的隨機 ID 重新開始。"
          }
        }
      }
    },
