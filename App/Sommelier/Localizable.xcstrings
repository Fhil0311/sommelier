    "Install mods in one click and switch them on before you play. Sommelier will check that the game still starts with them." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стаўце моды ў адзін клік і ўключайце іх перад запускам. Sommelier праверыць, што гульня з імі запускаецца."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mods mit einem Klick installieren und vor dem Spielen einschalten. Sommelier prüft, ob das Spiel damit noch startet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala mods con un clic y actívalos antes de jugar. Sommelier comprobará que el juego sigue arrancando con ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez des mods en un clic et activez-les avant de jouer. Sommelier vérifiera que le jeu se lance toujours avec eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa le mod con un clic e attivale prima di giocare. Sommelier controllerà che il gioco parta ancora con le mod."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワンクリックで Mod をインストールし、プレイ前にオン・オフできます。Sommelier が Mod 入りでもゲームが起動するか確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭 한 번으로 모드를 설치하고 플레이 전에 켜세요. Sommelier가 모드를 켠 상태로 게임이 실행되는지 확인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeer mods met één klik en zet ze aan voordat je speelt. Sommelier controleert of de game er nog mee start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaluj mody jednym kliknięciem i włączaj je przed grą. Sommelier sprawdzi, czy gra nadal się z nimi uruchamia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale mods com um clique e ative antes de jogar. O Sommelier verifica se o jogo ainda abre com eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставьте моды в один клик и включайте их перед запуском. Sommelier проверит, что игра с ними запускается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installera moddar med ett klick och slå på dem innan du spelar. Sommelier kontrollerar att spelet fortfarande startar med dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modları tek tıkla yükleyin ve oynamadan önce açın. Sommelier, oyunun onlarla hâlâ başladığını denetler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставте моди в один клік і вмикайте їх перед запуском. Sommelier перевірить, що гра з ними запускається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一键安装模组，并在开始游戏前启用。Sommelier 会检查游戏加载模组后能否启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一鍵安裝模組，開玩前再開啟。Sommelier 會確認遊戲搭配模組仍能啟動。"
          }
        }
      }
    },
