    "Movies › %@. Clips are ordinary video files: move or delete them in Finder as you like." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Фільмы › %@». Кліпы — звычайныя відэафайлы: перамяшчайце і выдаляйце іх у Finder як хочаце."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filme › %@. Clips sind normale Videodateien: Verschieben oder löschen Sie sie im Finder, wie Sie möchten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Películas › %@. Los clips son vídeos normales: muévelos o bórralos en el Finder como quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Films › %@. Les clips sont des fichiers vidéo ordinaires : déplacez-les ou supprimez-les dans le Finder comme bon vous semble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmati › %@. Le clip sono normali file video: spostale o eliminale nel Finder come vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ムービー › %@。クリップは普通のビデオファイルなので、Finder で自由に移動・削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상 › %@. 클립은 일반 비디오 파일이므로 Finder에서 자유롭게 옮기거나 삭제할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Films › %@. Clips zijn gewone videobestanden: verplaats of verwijder ze in de Finder zoals je wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmy › %@. Klipy to zwykłe pliki wideo: przenoś je lub usuwaj w Finderze, jak chcesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmes › %@. Os clipes são vídeos comuns: mova ou apague no Finder como quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Фильмы › %@». Клипы — обычные видеофайлы: перемещайте и удаляйте их в Finder как хотите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmer › %@. Klipp är vanliga videofiler: flytta eller radera dem i Finder som du vill."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmler › %@. Klipler sıradan video dosyalarıdır: Finder'da istediğiniz gibi taşıyın veya silin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Фільми › %@». Кліпи — звичайні відеофайли: переміщуйте й видаляйте їх у Finder як завгодно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片 › %@。剪辑就是普通视频文件：可以在访达中随意移动或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
