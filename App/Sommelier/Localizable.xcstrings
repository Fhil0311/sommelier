    "While a PlayStation controller is connected, these games show its buttons instead of Xbox ones." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакуль падключаны геймпад PlayStation, такія гульні паказваюць яго кнопкі, а не кнопкі Xbox."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange ein PlayStation-Controller verbunden ist, zeigen diese Spiele seine Tasten statt der Xbox-Tasten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras haya un mando de PlayStation conectado, estos juegos muestran sus botones en vez de los de Xbox."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant qu’une manette PlayStation est connectée, ces jeux affichent ses boutons au lieu de ceux de la Xbox."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché è collegato un controller PlayStation, questi giochi mostrano i suoi tasti invece di quelli Xbox."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation コントローラーの接続中は、対応ゲームで Xbox ではなく PlayStation のボタンが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation 컨트롤러가 연결되어 있으면 이 게임들은 Xbox 대신 PlayStation 버튼을 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zolang er een PlayStation-controller verbonden is, tonen deze games zijn knoppen in plaats van die van Xbox."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy podłączony jest pad PlayStation, te gry pokazują jego przyciski zamiast przycisków Xbox."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto um controle PlayStation estiver conectado, esses jogos mostram os botões dele em vez dos do Xbox."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока подключён геймпад PlayStation, такие игры показывают его кнопки, а не кнопки Xbox."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så länge en PlayStation-handkontroll är ansluten visar de här spelen dess knappar i stället för Xbox-knapparna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir PlayStation kumandası bağlıyken bu oyunlar Xbox düğmeleri yerine onun düğmelerini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки підключено геймпад PlayStation, такі ігри показують його кнопки, а не кнопки Xbox."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 PlayStation 手柄时，这些游戏会显示它的按键，而不是 Xbox 按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接 PlayStation 控制器時，這些遊戲會顯示它的按鈕，而不是 Xbox 按鈕。"
          }
        }
      }
    },
    "While you browse. The Mac sleeps as usual after you leave Controller Mode." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакуль вы выбіраеце гульню. Пасля выхаду з рэжыму Mac засынае як звычайна."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Stöbern. Nach dem Verlassen des Controller-Modus geht der Mac wie gewohnt in den Ruhezustand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras navegas. El Mac entra en reposo como siempre al salir del modo mando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que vous naviguez. Le Mac se met en veille comme d'habitude après le mode manette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre sfogli. Il Mac va in stop come al solito quando esci dalla modalità controller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んでいる間だけです。コントローラーモードを終了すると、Mac は通常どおりスリープします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘러보는 동안만입니다. 컨트롤러 모드를 나가면 Mac이 평소처럼 잠자기 상태가 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens het bladeren. De Mac gaat zoals gewoonlijk in sluimer nadat je de controllermodus verlaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas przeglądania. Po wyjściu z trybu pada Mac usypia się jak zwykle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto você navega. O Mac entra em repouso como sempre depois que você sai do modo controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока вы выбираете игру. После выхода из режима Mac засыпает как обычно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan du bläddrar. Macen går i vila som vanligt när du lämnar handkontrolläget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göz atarken. Oyun kumandası modundan çıkınca Mac her zamanki gibi uyur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки ви вибираєте гру. Після виходу з режиму Mac засинає як зазвичай."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在浏览时。离开手柄模式后，Mac 照常进入睡眠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅限瀏覽時。離開控制器模式後，Mac 會照常進入睡眠。"
          }
        }
      }
    },
    "While you play, Sommelier keeps the last 30 seconds to 2 minutes of the game in memory. Press %@ and they become a clip. If you don’t press it, nothing is kept." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакуль вы гуляеце, Sommelier трымае ў памяці апошнія 30 секунд – 2 хвіліны гульні. Націсніце %@, і яны стануць кліпам. Не націснулі — нічога не захоўваецца."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während Sie spielen, behält Sommelier die letzten 30 Sekunden bis 2 Minuten des Spiels im Speicher. Drücken Sie %@, und daraus wird ein Clip. Wenn nicht, wird nichts behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras juegas, Sommelier guarda en memoria entre los últimos 30 segundos y 2 minutos del juego. Pulsa %@ y se convierten en un clip. Si no la pulsas, no se guarda nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que vous jouez, Sommelier garde en mémoire les 30 dernières secondes à 2 minutes du jeu. Appuyez sur %@ et elles deviennent un clip. Sinon, rien n'est gardé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre giochi, Sommelier tiene in memoria dagli ultimi 30 secondi ai 2 minuti di gioco. Premi %@ e diventano una clip. Se non lo premi, non resta nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイ中、Sommelier はゲームの直前 30 秒〜2 分をメモリに保持します。%@ を押すとクリップになります。押さなければ何も残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이하는 동안 Sommelier가 게임의 최근 30초~2분을 메모리에 보관합니다. %@ 키를 누르면 클립이 됩니다. 누르지 않으면 아무것도 남지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl je speelt, houdt Sommelier de laatste 30 seconden tot 2 minuten van de game in het geheugen. Druk op %@ en ze worden een clip. Druk je niet, dan wordt er niets bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas gry Sommelier trzyma w pamięci ostatnie 30 sekund – 2 minuty. Naciśnij %@, a staną się klipem. Jeśli nie naciśniesz, nic nie zostaje zapisane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto você joga, o Sommelier guarda na memória de 30 segundos a 2 minutos finais do jogo. Pressione %@ e eles viram um clipe. Se não pressionar, nada fica salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока вы играете, Sommelier держит в памяти последние 30 секунд – 2 минуты игры. Нажмите %@, и они станут клипом. Не нажали — ничего не сохраняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan du spelar håller Sommelier de senaste 30 sekunderna till 2 minuterna av spelet i minnet. Tryck på %@ så blir de ett klipp. Trycker du inte sparas ingenting."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz oynarken Sommelier oyunun son 30 saniye ile 2 dakikasını bellekte tutar. %@ tuşuna basın, klip olsun. Basmazsanız hiçbir şey saklanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки ви граєте, Sommelier тримає в пам’яті останні 30 секунд – 2 хвилини гри. Натисніть %@, і вони стануть кліпом. Не натиснули — нічого не зберігається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏时，Sommelier 会在内存中保留最近 30 秒到 2 分钟的画面。按下 %@ 即可变成剪辑。不按就什么都不会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊玩時，Sommelier 會在記憶體中保留最後 30 秒到 2 分鐘的畫面。按下 %@ 就會變成剪輯。不按就什麼都不會保留。"
          }
        }
      }
    },
