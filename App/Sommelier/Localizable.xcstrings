    "A demanding game: a recent Mac should handle it, a basic one may not." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цяжкая гульня: новы Mac справіцца, базавы можа не пацягнуць."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anspruchsvolles Spiel: Ein neuerer Mac sollte es schaffen, ein Einstiegsmodell eher nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juego exigente: un Mac reciente debería poder con él; uno básico, quizá no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeu exigeant : un Mac récent devrait suivre, un modèle d'entrée de gamme peut-être pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gioco pesante: un Mac recente dovrebbe reggerlo, uno base forse no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重いゲームです。新しい Mac なら動きますが、ベースモデルでは厳しいかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고사양 게임: 최신 Mac은 문제없지만 기본 모델은 힘들 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een zware game: een recente Mac kan het aan, een instapmodel misschien niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagająca gra: nowy Mac da radę, podstawowy może nie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogo pesado: um Mac recente deve aguentar, um básico talvez não."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяжёлая игра: новый Mac справится, базовый может не потянуть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett krävande spel: en nyare Mac klarar det, en enklare kanske inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorlu bir oyun: yeni bir Mac kaldırır, temel bir model kaldıramayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Важка гра: новий Mac упорається, базовий може не потягнути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这款游戏要求较高：较新的 Mac 能应付，入门款可能不行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高需求遊戲：較新的 Mac 應該能應付，基本款可能吃不消。"
          }
        }
      }
    },
    "A demanding game: a recent Mac should run it well, a basic one may struggle." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цяжкая гульня: на новым Mac пойдзе добра, на базавым можа тармазіць."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anspruchsvolles Spiel: Auf einem neueren Mac läuft es gut, auf einem Einstiegsmodell eventuell zäh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juego exigente: en un Mac reciente debería ir bien; en uno básico puede ir a tirones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeu exigeant : il tourne bien sur un Mac récent, un modèle d'entrée de gamme peut ramer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gioco pesante: su un Mac recente va bene, su uno base potrebbe arrancare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重いゲームです。新しい Mac なら快適ですが、ベースモデルでは厳しいかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고사양 게임: 최신 Mac에서는 잘 돌아가지만 기본 모델에서는 버벅일 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een zware game: op een recente Mac loopt hij goed, op een instapmodel kan hij haperen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagająca gra: na nowym Macu pójdzie dobrze, na podstawowym może się przycinać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogo pesado: num Mac recente deve rodar bem, num básico pode engasgar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяжёлая игра: на новом Mac пойдёт хорошо, на базовом может тормозить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett krävande spel: på en nyare Mac går det bra, på en enklare kan det hacka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorlu bir oyun: yeni bir Mac'te iyi çalışır, temel bir modelde zorlanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Важка гра: на новому Mac піде добре, на базовому може гальмувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这款游戏要求较高：较新的 Mac 能流畅运行，入门款可能会吃力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高需求遊戲：較新的 Mac 應該跑得順，基本款可能會卡。"
          }
        }
      }
    },
    "A folder the mod needs can't be reached for this copy of the game." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка, нужная моду, недоступна для этой копии игры."
          }
        }
      }
    },
    "A folder the mods need can't be reached for this copy of the game." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка, нужная модам, недоступна для этой копии игры."
          }
        }
      }
    },
    "A game's first run stutters while its shaders are translated for Metal. With sharing on, translations other players already made come down before the game starts, and yours go up after you play. Nothing identifies you: only the shaders themselves." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームの初回起動時は、シェーダーを Metal 用に変換する間カクつきます。共有をオンにすると、ほかのプレイヤーが変換済みのシェーダーが起動前にダウンロードされ、あなたの分はプレイ後にアップロードされます。個人を特定する情報は送られません。シェーダーそのものだけです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первый запуск игры без подёргиваний: готовые шейдеры скачиваются заранее, ваши помогают другим. Только сами шейдеры, ничего личного."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏首次运行时，着色器需要先转换为 Metal，画面会卡顿。开启共享后，其他玩家已完成的转换会在游戏启动前下载，你的转换会在游戏结束后上传。不会传送任何身份信息，只有着色器本身。"
          }
        }
      }
    },
    "A game's first run without stutter: ready-made shaders download in advance, and yours help other players. Only the shaders themselves, nothing personal." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Першы запуск гульні без рыўкоў: гатовыя шэйдары спампоўваюцца загадзя, а вашы дапамагаюць іншым. Толькі самі шэйдары, нічога асабістага."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Start eines Spiels ohne Ruckler: Fertige Shader werden vorab geladen, und Ihre helfen anderen. Nur die Shader selbst, nichts Persönliches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primera partida sin tirones: los shaders listos se descargan antes, y los tuyos ayudan a otros jugadores. Solo los shaders, nada personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier lancement sans saccades : les shaders prêts à l'emploi sont téléchargés à l'avance, et les vôtres aident les autres joueurs. Seulement les shaders, rien de personnel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primo avvio senza scatti: gli shader pronti vengono scaricati in anticipo e i tuoi aiutano gli altri giocatori. Solo gli shader, niente di personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初回からカクつかずにプレイ：ビルド済みシェーダーを事前にダウンロードし、この Mac のシェーダーもほかのプレイヤーの役に立ちます。送るのはシェーダーだけで、個人情報は含みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 실행부터 끊김 없이: 미리 만든 셰이더를 먼저 다운로드하고, 내 셰이더는 다른 플레이어에게 도움이 됩니다. 셰이더만 보내며 개인 정보는 보내지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eerste keer spelen zonder haperingen: kant-en-klare shaders worden vooraf gedownload, en de jouwe helpen andere spelers. Alleen de shaders zelf, niets persoonlijks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwsze uruchomienie gry bez przycięć: gotowe shadery pobierają się z wyprzedzeniem, a twoje pomagają innym graczom. Tylko same shadery, nic osobistego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeira execução sem engasgos: os shaders prontos são baixados antes, e os seus ajudam outros jogadores. Só os shaders, nada pessoal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первый запуск игры без подёргиваний: готовые шейдеры скачиваются заранее, ваши помогают другим. Только сами шейдеры, ничего личного."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Första starten utan hack: färdiga shaders hämtas i förväg, och dina hjälper andra spelare. Bara själva shaderna, inget personligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyunun ilk açılışı takılmadan: hazır shader'lar önceden indirilir, sizinkiler de diğer oyunculara yardım eder. Yalnızca shader'lar, kişisel hiçbir şey yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перший запуск гри без підвисань: готові шейдери завантажуються заздалегідь, а ваші допомагають іншим. Лише самі шейдери, нічого особистого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏首次运行不再卡顿：预编译着色器会提前下载，你的着色器也能帮到其他玩家。只共享着色器本身，不含个人信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲首次執行不卡頓：預先下載現成的著色器，你的著色器也能幫助其他玩家。只會傳送著色器本身，不含任何個人資料。"
          }
        }
      }
    },
    "A library the game needs is missing from the environment. The log names it; this is usually a runtime the game's installer would have added." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У асяроддзі няма бібліятэкі, патрэбнай гульні. Яе назва ёсць у журнале; звычайна гэта кампанент, які ставіць усталёўшчык гульні."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Umgebung fehlt eine Bibliothek, die das Spiel braucht. Das Protokoll nennt sie; meist ist es eine Laufzeitkomponente, die der Installer des Spiels mitbringen würde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta en el entorno una biblioteca que el juego necesita. El registro dice cuál; suele ser un componente que habría instalado el instalador del juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque une bibliothèque dont le jeu a besoin. Le journal indique laquelle ; c'est souvent un runtime que l'installateur du jeu aurait ajouté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca una libreria che serve al gioco. Il log dice quale; di solito è un runtime che avrebbe aggiunto il programma di installazione del gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームに必要なライブラリが環境にありません。ログに名前があります。通常はゲームのインストーラーが追加するランタイムです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "환경에 게임에 필요한 라이브러리가 없습니다. 로그에 이름이 나와 있으며, 보통 게임 설치 프로그램이 추가하는 런타임입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ontbreekt een bibliotheek die de game nodig heeft. Het log noemt de naam; meestal is het een runtime die de installer van de game had moeten toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W środowisku brakuje biblioteki potrzebnej grze. Jej nazwa jest w logu; zwykle to składnik, który dodałby instalator gry."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta no ambiente uma biblioteca de que o jogo precisa. O registro diz qual; em geral é um componente que o instalador do jogo teria adicionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В окружении нет библиотеки, нужной игре. В журнале указано её имя; обычно это компонент, который ставит установщик игры."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett bibliotek som spelet behöver saknas i miljön. Loggen visar vilket – oftast en runtime som spelets installationsprogram skulle ha lagt till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyunun ihtiyaç duyduğu bir kütüphane ortamda yok. Adı günlükte yazar; genelde oyunun yükleyicisinin eklemesi gereken bir çalışma zamanıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У середовищі бракує бібліотеки, потрібної грі. Її назва є в журналі; зазвичай це компонент, який ставить інсталятор гри."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "环境中缺少游戏所需的库。日志中有它的名称；这通常是游戏安装程序会添加的运行时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境中缺少遊戲需要的資源庫。記錄檔中有它的名稱；這通常是遊戲安裝程式本該加入的執行環境。"
          }
        }
      }
    },
