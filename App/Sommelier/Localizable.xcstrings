    "This game needs DirectX 12. Set it up once, and every DirectX 12 game can run." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэтай гульні патрэбны DirectX 12. Наладзьце яго адзін раз, і запусцяцца ўсе гульні на DirectX 12."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Spiel braucht DirectX 12. Einmal einrichten, und jedes DirectX-12-Spiel kann laufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este juego necesita DirectX 12. Configúralo una vez y podrás jugar a cualquier juego DirectX 12."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu nécessite DirectX 12. Configurez-le une fois, et tous les jeux DirectX 12 pourront tourner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo gioco richiede DirectX 12. Configuralo una volta e tutti i giochi DirectX 12 potranno girare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゲームにはDirectX 12が必要です。一度設定すれば、DirectX 12のゲームをすべて実行できます。"
