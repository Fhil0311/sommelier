          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o jogo. Outros apps e o microfone nunca são gravados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
