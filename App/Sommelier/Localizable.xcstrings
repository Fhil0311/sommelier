          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam wciąż się uruchamia. Pierwsze uruchomienie trwa dłużej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
