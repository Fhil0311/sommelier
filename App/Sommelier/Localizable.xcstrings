    "No clips yet. Hold the %@ button while you play to save the last %lld seconds." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кліпаў пакуль няма. Утрымлівайце кнопку %@ падчас гульні, каб захаваць апошнія %lld с."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Clips. Halten Sie beim Spielen die Taste %@, um die letzten %lld Sekunden zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay clips. Mantén pulsado el botón %@ mientras juegas para guardar los últimos %lld segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun clip pour l'instant. Maintenez le bouton %@ en jouant pour garder les %lld dernières secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna clip. Tieni premuto il tasto %@ mentre giochi per salvare gli ultimi %lld secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップはまだありません。プレイ中に %@ ボタンを長押しすると、直前 %lld 秒を保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 클립이 없습니다. 플레이 중 %@ 버튼을 길게 누르면 최근 %lld초가 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen clips. Houd tijdens het spelen de %@-knop ingedrukt om de laatste %lld seconden te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze nie ma klipów. Przytrzymaj przycisk %@ podczas gry, aby zapisać ostatnie %lld s."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum clipe ainda. Segure o botão %@ enquanto joga para salvar os últimos %lld segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клипов пока нет. Удерживайте кнопку %@ во время игры, чтобы сохранить последние %lld секунд."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga klipp än. Håll in %@-knappen medan du spelar för att spara de senaste %lld sekunderna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz klip yok. Son %2$lld saniyeyi kaydetmek için oynarken %1$@ düğmesini basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кліпів поки немає. Утримуйте кнопку %@ під час гри, щоб зберегти останні %lld с."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有剪辑。游戏时按住 %@ 按钮即可保存最近 %lld 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有剪輯。遊玩時按住 %@ 按鈕即可保存最後 %lld 秒。"
          }
        }
      }
    },
