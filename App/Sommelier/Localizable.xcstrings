          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego necesita el runtime de Visual C++, que no está en el entorno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu nécessite le runtime Visual C++, absent de l'environnement."
          }
        },
        "it" : {
