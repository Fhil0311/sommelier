        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 데이터는 유지됩니다. 언제든지 다시 설치할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je saves blijven. Je kunt de game altijd opnieuw installeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisy gry zostaną. Możesz ją zainstalować ponownie w każdej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus saves ficam. Você pode instalar de novo quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранения останутся. Игру можно установить снова в любой момент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina sparningar finns kvar. Du kan installera det igen när som helst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlarınız kalır. Oyunu istediğiniz zaman yeniden yükleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збереження залишаться. Гру можна встановити знову будь-коли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存档会保留。你可以随时重新安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存檔會保留。隨時可以重新安裝。"
          }
        }
      }
    },
