    "Clips need at least 2 GB free on this Mac. Free up space, or remove some clips below." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кліпам трэба хаця б 2 ГБ вольнага месца на гэтым Mac. Вызваліце месца або выдаліце частку кліпаў ніжэй."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clips brauchen mindestens 2 GB freien Speicher auf diesem Mac. Geben Sie Speicher frei oder entfernen Sie unten einige Clips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips necesitan al menos 2 GB libres en este Mac. Libera espacio o borra algunos clips de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clips demandent au moins 2 Go libres sur ce Mac. Libérez de l'espace ou supprimez des clips ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip richiedono almeno 2 GB liberi su questo Mac. Libera spazio o rimuovi alcune clip qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップにはこの Mac に 2 GB 以上の空きが必要です。空き容量を増やすか、下のクリップを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립에는 이 Mac에 최소 2GB의 여유 공간이 필요합니다. 공간을 확보하거나 아래에서 클립을 일부 삭제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clips hebben minstens 2 GB vrije ruimte nodig op deze Mac. Maak ruimte vrij of verwijder hieronder wat clips."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipy potrzebują co najmniej 2 GB wolnego miejsca na tym Macu. Zwolnij miejsce albo usuń część klipów poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os clipes precisam de pelo menos 2 GB livres neste Mac. Libere espaço ou remova alguns clipes abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клипам нужно хотя бы 2 ГБ свободных на этом Mac. Освободите место или удалите часть клипов ниже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipp behöver minst 2 GB ledigt på den här Macen. Frigör utrymme eller ta bort några klipp nedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipler için bu Mac'te en az 2 GB boş alan gerekir. Yer açın veya aşağıdan bazı klipleri silin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кліпам потрібно щонайменше 2 ГБ вільного місця на цьому Mac. Звільніть місце або видаліть частину кліпів нижче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪辑需要这台 Mac 上至少有 2 GB 可用空间。请释放空间，或删除下方的部分剪辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪輯需要這台 Mac 至少有 2 GB 可用空間。請釋放空間，或刪除下方的部分剪輯。"
          }
        }
      }
    },
    "Clips take %@ in Movies › %@. Automatic clips use up to %lld GB; the oldest go first." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кліпы займаюць %@ у «Фільмы › %@». Аўтаматычныя кліпы займаюць да %lld ГБ, старыя выдаляюцца першымі."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clips belegen %@ in Filme › %@. Automatische Clips nutzen bis zu %lld GB; die ältesten gehen zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips ocupan %@ en Películas › %@. Los clips automáticos usan hasta %lld GB; los más antiguos se borran primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clips occupent %@ dans Films › %@. Les clips auto utilisent jusqu'à %lld Go ; les plus anciens partent en premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip occupano %@ in Filmati › %@. Le clip automatiche usano fino a %lld GB; le più vecchie vanno via per prime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップの使用量: %@（ムービー › %@）。自動クリップは最大 %lld GB まで使い、古いものから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립이 동영상 › %2$@에서 %1$@를 사용 중입니다. 자동 클립은 최대 %3$lldGB까지 사용하며, 오래된 것부터 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clips nemen %@ in beslag in Films › %@. Automatische clips gebruiken tot %lld GB; de oudste gaan eerst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipy zajmują %@ w Filmy › %@. Automatyczne klipy zajmują do %lld GB, najstarsze znikają pierwsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os clipes ocupam %@ em Filmes › %@. Clipes automáticos usam até %lld GB; os mais antigos saem primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клипы занимают %@ в «Фильмы › %@». Автоматические клипы занимают до %lld ГБ, старые удаляются первыми."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klippen tar %@ i Filmer › %@. Automatiska klipp använder upp till %lld GB; de äldsta tas bort först."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipler Filmler › %2$@ içinde %1$@ yer kaplıyor. Otomatik klipler en fazla %3$lld GB kullanır; önce en eskiler silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кліпи займають %@ у «Фільми › %@». Автоматичні кліпи займають до %lld ГБ, старі видаляються першими."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪辑在“影片 › %2$@”中占用 %1$@。自动剪辑最多占用 %3$lld GB，最旧的先删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪輯在「影片 › %2$@」中佔用 %1$@。自動剪輯最多佔用 %3$lld GB，最舊的會先刪除。"
          }
        }
      }
    },
