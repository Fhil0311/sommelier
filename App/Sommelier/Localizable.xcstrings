    "Less than 30 GB free. Games may not fit." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вольна менш за 30 ГБ. Гульні могуць не змясціцца."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als 30 GB frei. Spiele passen eventuell nicht drauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de 30 GB libres. Puede que los juegos no quepan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de 30 Go libres. Les jeux risquent de ne pas tenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno di 30 GB liberi. I giochi potrebbero non entrarci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き容量が30 GB未満です。ゲームが収まらない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여유 공간이 30GB 미만입니다. 게임이 들어가지 않을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minder dan 30 GB vrij. Games passen misschien niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolne mniej niż 30 GB. Gry mogą się nie zmieścić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
