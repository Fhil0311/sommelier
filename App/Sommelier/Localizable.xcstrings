    "Your own settings are kept: Restore My Settings on a game's page puts them back. Turn this off for every game in Settings." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашы налады захоўваюцца: кнопка «Вярнуць мае налады» на старонцы гульні вяртае іх. Выключыць гэта для ўсіх гульняў можна ў наладах."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre eigenen Einstellungen bleiben erhalten: „Meine Einstellungen wiederherstellen“ auf der Seite des Spiels holt sie zurück. Für alle Spiele ausschalten können Sie das in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus ajustes se conservan: Restaurar mis ajustes, en la página del juego, los recupera. Desactívalo para todos los juegos en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos propres paramètres sont conservés : Restaurer mes paramètres, sur la page du jeu, les remet. Désactivez l'option pour tous les jeux dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue impostazioni vengono conservate: Ripristina le mie impostazioni, nella pagina del gioco, le rimette. Disattiva l'opzione per tutti i giochi nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の設定は保存されます。ゲームのページの「自分の設定に戻す」で元に戻せます。すべてのゲームでオフにするには設定で変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 설정은 보관됩니다. 게임 페이지의 내 설정 복원을 누르면 되돌릴 수 있습니다. 모든 게임에서 끄려면 설정을 이용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je eigen instellingen blijven bewaard: ‘Zet mijn instellingen terug’ op de pagina van een game haalt ze terug. Zet dit voor alle games uit in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje ustawienia są zachowane: przycisk Przywróć moje ustawienia na stronie gry je przywraca. Wyłącz to dla wszystkich gier w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus ajustes ficam guardados: Restaurar meus ajustes, na página do jogo, os traz de volta. Desative para todos os jogos nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши настройки сохраняются: кнопка «Вернуть мои настройки» на странице игры возвращает их. Выключить это для всех игр можно в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina egna inställningar sparas: Återställ mina inställningar på spelets sida tar tillbaka dem. Stäng av detta för alla spel i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi ayarlarınız saklanır: oyun sayfasındaki Ayarlarımı geri yükle düğmesi onları geri getirir. Bunu tüm oyunlar için Ayarlar'dan kapatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші налаштування зберігаються: кнопка «Повернути мої налаштування» на сторінці гри повертає їх. Вимкнути це для всіх ігор можна в параметрах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你自己的设置会被保留：在游戏页面点按“恢复我的设置”即可恢复。可在设置中为所有游戏关闭此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的設定會保留：在遊戲頁面點「回復我的設定」即可恢復。可在「設定」中為所有遊戲關閉此功能。"
          }
        }
      }
    },
    "Your password goes only to %@. Sommelier keeps just the sign-in token, on this Mac." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль атрымлівае толькі %@. Sommelier захоўвае толькі токен уваходу — на гэтым Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Passwort geht nur an %@. Sommelier speichert nur das Anmeldetoken, auf diesem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña solo va a %@. Sommelier solo guarda el token de sesión, en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe ne va qu'à %@. Sommelier ne garde que le jeton de connexion, sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password va solo a %@. Sommelier conserva solo il token di accesso, su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードは %@ にのみ送信されます。Sommelier はサインイン用トークンだけをこの Mac に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 %@에만 전송됩니다. Sommelier는 로그인 토큰만 이 Mac에 보관합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wachtwoord gaat alleen naar %@. Sommelier bewaart alleen het inlogtoken, op deze Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło trafia tylko do %@. Sommelier przechowuje tylko token logowania, na tym Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha vai só para %@. O Sommelier guarda apenas o token de sessão, neste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль получает только %@. Sommelier хранит лишь токен входа — на этом Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösenordet går bara till %@. Sommelier sparar bara inloggningstoken, på den här Macen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolanız yalnızca %@ hizmetine gider. Sommelier bu Mac'te yalnızca giriş belirtecini saklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль отримує лише %@. Sommelier зберігає тільки токен входу — на цьому Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的密码只会发送给 %@。Sommelier 仅在这台 Mac 上保存登录令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼只會傳給 %@。Sommelier 只在這部 Mac 上保存登入權杖。"
          }
        }
      }
    },
    "Your saves stay. You can install it again at any time." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захаванні застануцца. Гульню можна ўсталяваць зноў у любы момант."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Spielstände bleiben. Sie können es jederzeit wieder installieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus partidas guardadas se quedan. Puedes volver a instalarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos sauvegardes restent. Vous pouvez le réinstaller à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I salvataggi restano. Puoi reinstallarlo quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
