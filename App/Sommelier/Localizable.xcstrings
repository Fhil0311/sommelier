            "value" : "Votre copie %1$@ existe en version Mac. Téléchargez-la depuis %2$@ pour jouer en natif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua copia su %1$@ ha una versione per Mac. Scaricala da %2$@ per giocare in modo nativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ で所有しているこのゲームには Mac 版があります。%@ からダウンロードするとネイティブに遊べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 보유한 이 게임은 Mac 버전이 있습니다. %2$@에서 다운로드해 네이티브로 플레이하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kopie bij %1$@ heeft een Mac-versie. Download die van %2$@ om native te spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja kopia z %1$@ ma wersję na Maca. Pobierz ją z %2$@, aby grać natywnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua cópia de %1$@ tem versão para Mac. Baixe em %2$@ para jogar nativamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вашей копии в %@ есть версия для Mac. Скачайте её из %@, чтобы играть нативно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kopia på %1$@ har en Mac-version. Hämta den från %2$@ för att spela nativt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kopyanızın Mac sürümü var. Yerel olarak oynamak için %2$@ üzerinden indirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша копія в %1$@ має версію для Mac. Завантажте її з %2$@, щоб грати нативно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
