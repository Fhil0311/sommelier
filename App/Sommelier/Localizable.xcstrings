        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームの評価に数えられなくなります。元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 평가에 더 이상 반영되지 않습니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze tellen dan niet meer mee in de beoordelingen van games. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestaną być liczone w ocenach gier. Tego nie da się cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles deixam de contar nas notas dos jogos. Não dá para desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они перестанут учитываться в оценках игр. Отменить это нельзя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelens betyg slutar räkna med dem. Det går inte att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun puanları artık bunları saymaz. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вони перестануть враховуватися в оцінках ігор. Скасувати це неможливо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏评分将不再计入这些报告。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲評分將不再計入這些報告。此動作無法還原。"
          }
        }
      }
