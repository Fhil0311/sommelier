    "Too demanding for Steam Deck. A fast Mac may run it well; a basic one may struggle." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Deck には負荷が高すぎます。高性能な Mac なら快適に動く可能性があり、エントリーモデルでは重いかもしれません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком требовательна для Steam Deck. На мощном Mac может идти хорошо, на базовом — тормозить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对 Steam Deck 来说要求太高。性能强的 Mac 可能流畅运行，入门款可能会吃力。"
          }
        }
      }
    },
    "Too demanding for Steam Deck. A recent Mac is faster, so it may run here." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Deckには負荷が高すぎます。最近のMacはより高速なので、ここでは動作するかもしれません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком требовательна для Steam Deck. Современный Mac быстрее, так что здесь она может заработать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
