    "Open Steam, sign in and install a game. It appears here by itself after a refresh." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адкрыйце Steam, увайдзіце і ўсталюйце гульню. Пасля абнаўлення яна з’явіцца тут сама."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Steam, melden Sie sich an und installieren Sie ein Spiel. Nach dem Aktualisieren erscheint es von selbst hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Steam, inicia sesión e instala un juego. Aparecerá aquí solo al actualizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Steam, connectez-vous et installez un jeu. Il apparaîtra ici tout seul après une actualisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Steam, accedi e installa un gioco. Comparirà qui da solo dopo un aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steamを開いてサインインし、ゲームをインストールしてください。更新すると自動的にここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam을 열고 로그인한 다음 게임을 설치하세요. 새로 고침하면 여기에 자동으로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Steam, log in en installeer een game. Na het vernieuwen verschijnt die hier vanzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Steam, zaloguj się i zainstaluj grę. Po odświeżeniu pojawi się tu sama."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o Steam, inicie sessão e instale um jogo. Ele aparece aqui sozinho depois de atualizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Steam, войдите и установите игру. После обновления она появится здесь сама."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
