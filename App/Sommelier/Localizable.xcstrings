    "Open %@, sign in and install a game there. It appears here by itself." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адкрыйце %@, увайдзіце і ўсталюйце там гульню. Яна з’явіцца тут сама."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie %@, melden Sie sich an und installieren Sie dort ein Spiel. Es erscheint dann von selbst hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre %@, inicia sesión e instala un juego allí. Aparecerá aquí solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez %@, connectez-vous et installez-y un jeu. Il apparaîtra ici tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri %@, accedi e installa lì un gioco. Comparirà qui da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を開いてサインインし、そこでゲームをインストールしてください。ここに自動的に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 열고 로그인한 다음 게임을 설치하세요. 여기에 자동으로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open %@, log in en installeer daar een game. Die verschijnt hier vanzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz %@, zaloguj się i zainstaluj tam grę. Pojawi się tu sama."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra %@, inicie sessão e instale um jogo lá. Ele aparece aqui sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
