          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog leeg. Klik op + bij een cover hieronder om een game toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie pusto. Kliknij + na okładce poniżej, aby dodać grę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda vazia. Clique em + numa capa abaixo para adicionar um jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока пусто. Нажмите + на обложке ниже, чтобы добавить игру."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomt än så länge. Tryck på + på ett omslag nedan för att lägga till ett spel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdilik boş. Oyun eklemek için aşağıdaki bir kapakta + simgesine basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки порожньо. Натисніть + на обкладинці нижче, щоб додати гру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时为空。点按下方封面上的 + 来添加游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前是空的。點一下下方封面上的 + 來加入遊戲。"
          }
        }
      }
    },
