    "Chip, memory and macOS version. They tie your frame rates to your Mac model." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чып, памяць і версія macOS. Каб было відаць, як гульня ідзе менавіта на такім Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chip, Arbeitsspeicher und macOS-Version. So werden Ihre Bildraten Ihrem Mac-Modell zugeordnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chip, memoria y versión de macOS. Vinculan tus FPS a tu modelo de Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puce, mémoire et version de macOS. Ils relient vos FPS à votre modèle de Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chip, memoria e versione di macOS. Collegano i tuoi FPS al tuo modello di Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チップ、メモリ、macOS のバージョン。フレームレートを Mac のモデルに結び付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "칩, 메모리, macOS 버전. 같은 Mac 모델에서 게임이 어떻게 돌아가는지 알 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chip, geheugen en macOS-versie. Zo worden je framerates aan je Mac-model gekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Układ, pamięć i wersja macOS. Dzięki nim widać, jak gra działa na takim Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chip, memória e versão do macOS. Ligam seu FPS ao seu modelo de Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чип, память и версия macOS. Чтобы было видно, как игра идёт именно на таком Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chip, minne och macOS-version. De kopplar din bildfrekvens till din Mac-modell."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çip, bellek ve macOS sürümü. Kare hızlarınızı Mac modelinize bağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чип, пам’ять і версія macOS. Щоб було видно, як гра йде саме на такому Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芯片、内存和 macOS 版本。用于把你的帧率对应到你的 Mac 型号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晶片、記憶體和 macOS 版本。用來將影格率對應到 Mac 機型。"
          }
        }
      }
    },
