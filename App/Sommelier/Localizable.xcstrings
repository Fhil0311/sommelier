    },
    "Press Play. If something goes wrong, Sommelier names the cause and offers a fix." : {
      "extractionState" : "stale",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Націсніце «Гуляць». Калі нешта пойдзе не так, Sommelier назаве прычыну і прапануе выпраўленне."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf „Spielen“. Wenn etwas schiefgeht, nennt Sommelier die Ursache und schlägt eine Lösung vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa “Jugar”. Si algo falla, Sommelier te dice la causa y ofrece un arreglo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Jouer. En cas de problème, Sommelier en indique la cause et propose un correctif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi Gioca. Se qualcosa va storto, Sommelier ti dice la causa e propone una correzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「プレイ」を押してください。問題があれば Sommelier が原因を示し、修正を提案します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이를 누르세요. 문제가 생기면 Sommelier가 원인을 알려 주고 해결 방법을 제안합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op ‘Speel’. Als er iets misgaat, noemt Sommelier de oorzaak en biedt een oplossing aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij Graj. Jeśli coś pójdzie nie tak, Sommelier poda przyczynę i zaproponuje poprawkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em “Jogar”. Se algo der errado, o Sommelier aponta a causa e oferece uma correção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Играть». Если что-то пойдёт не так, Sommelier назовёт причину и предложит исправление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Spela. Om något går fel visar Sommelier orsaken och föreslår en lösning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyna'ya basın. Bir sorun çıkarsa Sommelier nedenini söyler ve bir çözüm önerir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть «Грати». Якщо щось піде не так, Sommelier назве причину й запропонує виправлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下“开始”。如果出了问题，Sommelier 会指出原因并提供修复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下「遊玩」。若出了問題，Sommelier 會指出原因並提供修正方式。"
          }
        }
      }
    },
