    "Installed games stay on this Mac. Sign in again to play them and see the rest of your library." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усталяваныя гульні застануцца на гэтым Mac. Увайдзіце зноў, каб гуляць у іх і бачыць усю бібліятэку."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installierte Spiele bleiben auf diesem Mac. Melden Sie sich erneut an, um sie zu spielen und den Rest Ihrer Bibliothek zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los juegos instalados se quedan en este Mac. Vuelve a iniciar sesión para jugarlos y ver el resto de tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jeux installés restent sur ce Mac. Reconnectez-vous pour y jouer et voir le reste de votre bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giochi installati restano su questo Mac. Accedi di nuovo per giocarci e vedere il resto della libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みのゲームはこの Mac に残ります。もう一度サインインすると、プレイしたりライブラリ全体を表示したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 게임은 이 Mac에 남아 있습니다. 다시 로그인하면 플레이하고 나머지 라이브러리도 볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geïnstalleerde games blijven op deze Mac. Log opnieuw in om ze te spelen en de rest van je bibliotheek te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstalowane gry zostaną na tym Macu. Zaloguj się ponownie, aby w nie grać i widzieć całą bibliotekę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os jogos instalados continuam neste Mac. Inicie sessão de novo para jogá-los e ver o resto da biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установленные игры останутся на этом Mac. Войдите снова, чтобы играть в них и видеть всю библиотеку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerade spel finns kvar på den här Macen. Logga in igen för att spela dem och se resten av biblioteket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklü oyunlar bu Mac'te kalır. Onları oynamak ve kitaplığınızın kalanını görmek için yeniden giriş yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановлені ігри залишаться на цьому Mac. Увійдіть знову, щоб грати в них і бачити всю бібліотеку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装的游戏会保留在这台 Mac 上。重新登录即可游玩并查看您的完整游戏库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝的遊戲會留在這部 Mac 上。重新登入即可遊玩，並看到遊戲庫中的其他遊戲。"
          }
        }
      }
    },
