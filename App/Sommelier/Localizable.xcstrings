    "The current saves are copied aside first, so this can be undone." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бягучыя захаванні спачатку будуць скапіяваны, так што гэта можна адмяніць."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuellen Spielstände werden vorher beiseitekopiert, das lässt sich also rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes se hace una copia de las partidas actuales, así que se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes actuelles sont d'abord mises de côté, donc c'est annulable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I salvataggi attuali vengono prima copiati a parte, quindi puoi annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のセーブデータは先に別に保存されるので、元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 저장 파일을 먼저 따로 복사하므로 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De huidige saves worden eerst apart gekopieerd, dus dit kan ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecne zapisy najpierw zostaną skopiowane, więc da się to cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os saves atuais são copiados antes, então dá para desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущие сохранения сначала будут скопированы, так что это можно отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nuvarande sparfilerna kopieras undan först, så det går att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut kayıtlar önce kenara kopyalanır, böylece bu işlem geri alınabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточні збереження спершу буде скопійовано, тож це можна скасувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前存档会先另行复制，因此可以撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的存檔會先另外複製一份，因此可以還原。"
          }
        }
      }
    },
    "The engine is Wine plus the graphics layers that translate DirectX to Metal." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рухавік — гэта Wine і графічныя слаі, якія перакладаюць DirectX на Metal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Engine ist Wine plus die Grafikschichten, die DirectX in Metal übersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor es Wine más las capas gráficas que traducen DirectX a Metal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur, c'est Wine plus les couches graphiques qui traduisent DirectX vers Metal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il motore è Wine più i livelli grafici che traducono DirectX in Metal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジンはWineと、DirectXをMetalに変換するグラフィックレイヤーで構成されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔진은 Wine과 DirectX를 Metal로 변환하는 그래픽 계층으로 구성됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De engine is Wine plus de graphicslagen die DirectX naar Metal vertalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silnik to Wine oraz warstwy graficzne, które tłumaczą DirectX na Metal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O motor é o Wine mais as camadas gráficas que traduzem DirectX para Metal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движок — это Wine и графические слои, которые переводят DirectX в Metal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motorn är Wine plus grafiklagren som översätter DirectX till Metal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motor, Wine ile DirectX'i Metal'e çeviren grafik katmanlarından oluşur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рушій — це Wine і графічні шари, які перекладають DirectX на Metal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引擎由 Wine 和将 DirectX 转换为 Metal 的图形层组成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引擎由 Wine 加上將 DirectX 轉譯為 Metal 的圖形層組成。"
          }
        }
      }
    },
    "The folder for new games isn't available. Connect its drive, or choose another folder in Settings." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка для новых гульняў недаступная. Падключыце яе дыск або выберыце іншую папку ў наладах."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner für neue Spiele ist nicht verfügbar. Schließen Sie das Laufwerk an oder wählen Sie in den Einstellungen einen anderen Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta para juegos nuevos no está disponible. Conecta su disco o elige otra carpeta en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier des nouveaux jeux n'est pas disponible. Branchez son disque ou choisissez un autre dossier dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella per i nuovi giochi non è disponibile. Collega il suo disco o scegli un'altra cartella nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいゲームのフォルダが使用できません。ドライブを接続するか、設定で別のフォルダを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
