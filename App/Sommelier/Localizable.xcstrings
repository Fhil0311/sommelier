    "Sign in on Apple's website if it asks. The download starts by itself, and Sommelier picks it up from Downloads." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі Apple папросіць, увайдзіце на яе сайце. Спампоўка пачнецца сама, а Sommelier забярэ файл са «Спамповак»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich auf der Apple-Website an, falls verlangt. Der Download startet von selbst, und Sommelier holt die Datei aus „Downloads“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Apple lo pide, inicia sesión en su web. La descarga empieza sola y Sommelier recoge el archivo de Descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous sur le site d’Apple si besoin. Le téléchargement démarre tout seul, et Sommelier récupère le fichier dans Téléchargements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se Apple lo chiede, accedi sul suo sito. Il download parte da solo e Sommelier prende il file da Download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "求められたら Apple の Web サイトでサインインしてください。ダウンロードは自動で始まり、Sommelier が「ダウンロード」から取り込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple이 요청하면 웹사이트에서 로그인하세요. 다운로드는 저절로 시작되고, Sommelier가 다운로드 폴더에서 파일을 가져갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in op de website van Apple als dat gevraagd wordt. De download start vanzelf en Sommelier pakt het bestand op uit Downloads."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli Apple poprosi, zaloguj się na jej stronie. Pobieranie ruszy samo, a Sommelier odbierze plik z Pobranych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a Apple pedir, entre no site dela. O download começa sozinho, e o Sommelier pega o arquivo em Downloads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если Apple попросит, войдите на её сайте. Загрузка начнётся сама, а Sommelier заберёт файл из Загрузок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in på Apples webbplats om den ber om det. Hämtningen startar av sig själv och Sommelier plockar upp filen från Hämtade filer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple isterse sitesinde giriş yapın. İndirme kendiliğinden başlar, Sommelier dosyayı İndirilenler’den alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо Apple попросить, увійдіть на її сайті. Завантаження почнеться саме, а Sommelier забере файл із Завантажень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 Apple 要求，请在其网站上登录。下载会自动开始，Sommelier 会从“下载”文件夹取走文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 Apple 要求，請在其網站登入。下載會自動開始，Sommelier 會從「下載項目」取走檔案。"
          }
        }
      }
    },
    "Sign in on Epic's website. Games download without a launcher" : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уваход на сайце Epic. Гульні спампоўваюцца без лаўнчара"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldung auf der Epic-Website. Spiele laden ohne Launcher"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicio de sesión en la web de Epic. Los juegos se descargan sin launcher"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion sur le site d'Epic. Les jeux se téléchargent sans launcher"
          }
        },
        "it" : {
          "stringUnit" : {
