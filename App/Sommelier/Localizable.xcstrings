        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster des Spiels hat sich zu oft geändert oder der Mac ist in den Ruhezustand gegangen. Beim nächsten Spiel startet die Aufnahme wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana del juego cambió demasiadas veces o el Mac entró en reposo. La grabación vuelve a empezar con el siguiente juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre du jeu a trop souvent changé, ou le Mac s'est mis en veille. L'enregistrement reprend avec le prochain jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finestra del gioco è cambiata troppo spesso o il Mac è andato in stop. La registrazione riparte con il prossimo gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームのウインドウが頻繁に変わったか、Mac がスリープしました。次のゲームから録画が再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 윈도우가 너무 자주 바뀌었거나 Mac이 잠자기 상태가 되었습니다. 다음 게임부터 다시 녹화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het venster van de game veranderde te vaak, of de Mac ging in sluimerstand. Bij de volgende game wordt weer opgenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno gry zmieniało się zbyt często albo Mac przeszedł w uśpienie. Nagrywanie ruszy znowu przy następnej grze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela do jogo mudou vezes demais ou o Mac entrou em repouso. A gravação volta no próximo jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окно игры слишком часто менялось, или Mac уснул. Запись снова начнётся со следующей игрой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelets fönster ändrades för ofta, eller så gick Macen i vila. Inspelningen startar igen med nästa spel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyunun penceresi çok sık değişti ya da Mac uyku moduna geçti. Kayıt bir sonraki oyunda yeniden başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вікно гри надто часто змінювалося, або Mac заснув. Запис знову почнеться з наступною грою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏窗口变化过于频繁，或 Mac 进入了睡眠。下一次游戏时会重新开始录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲視窗變動太頻繁，或 Mac 進入了睡眠。下一場遊戲會重新開始錄製。"
          }
        }
      }
    },
