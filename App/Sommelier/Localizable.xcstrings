    "macOS will ask you to allow screen recording for Sommelier. It may ask again from time to time." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS папросіць дазволіць Sommelier запіс экрана. Часам яна можа спытаць зноў."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wird Sie bitten, die Bildschirmaufnahme für Sommelier zu erlauben. Ab und zu fragt es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS te pedirá permitir la grabación de pantalla para Sommelier. Puede volver a pedirlo de vez en cuando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vous demandera d'autoriser l'enregistrement de l'écran pour Sommelier. Il peut redemander de temps en temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ti chiederà di consentire la registrazione dello schermo a Sommelier. Potrebbe richiederlo ogni tanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS から Sommelier の画面収録を許可するよう求められます。ときどき再度求められることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 Sommelier의 화면 기록을 허용하라고 요청합니다. 가끔 다시 요청할 수도 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vraagt je om schermopname toe te staan voor Sommelier. Dat kan af en toe opnieuw gebeuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS poprosi o zgodę na nagrywanie ekranu przez Sommelier. Czasem może zapytać ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS vai pedir para permitir a gravação de tela para o Sommelier. Ele pode pedir de novo de vez em quando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS попросит разрешить Sommelier запись экрана. Иногда она может спросить снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ber dig tillåta skärminspelning för Sommelier. Det kan fråga igen ibland."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, Sommelier için ekran kaydına izin vermenizi isteyecek. Ara sıra yeniden sorabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS попросить дозволити Sommelier запис екрана. Іноді вона може запитати знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 会请你允许 Sommelier 录屏，之后也可能偶尔再次询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 會要求允許 Sommelier 錄製螢幕，之後也可能偶爾再次詢問。"
          }
        }
      }
    },
