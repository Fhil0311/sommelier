    "%@'s cloud didn't answer. Playing now uses the saves on this Mac; they're synced next time." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воблака %@ не адказала. Зараз гульня пойдзе з захаваннямі гэтага Mac, сінхранізацыя адбудзецца наступным разам."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cloud von %@ antwortet nicht. Jetzt wird mit den Spielständen auf diesem Mac gespielt; sie werden beim nächsten Mal synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nube de %@ no respondió. Ahora se jugará con las partidas de este Mac; se sincronizarán la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cloud de %@ n'a pas répondu. Le jeu utilise les sauvegardes de ce Mac ; elles seront synchronisées la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cloud di %@ non ha risposto. Ora si gioca con i salvataggi di questo Mac; verranno sincronizzati la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のクラウドが応答しませんでした。今回はこの Mac のセーブデータでプレイし、次回に同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 클라우드가 응답하지 않았습니다. 지금은 이 Mac의 저장 파일로 플레이하며, 다음에 동기화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cloud van %@ reageert niet. Je speelt nu met de saves op deze Mac; ze worden de volgende keer gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chmura %@ nie odpowiedziała. Gra użyje zapisów z tego Maca; zsynchronizują się następnym razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nuvem de %@ não respondeu. Agora o jogo usa os saves deste Mac; eles serão sincronizados na próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облако %@ не ответило. Сейчас игра пойдёт с сохранениями этого Mac, синхронизация пройдёт в следующий раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molnet för %@ svarade inte. Spelet använder sparfilerna på den här Macen nu – de synkas nästa gång."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bulutu yanıt vermedi. Şimdi bu Mac'teki kayıtlarla oynanır; bir dahaki sefere eşzamanlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хмара %@ не відповіла. Зараз гра піде зі збереженнями цього Mac, синхронізація відбудеться наступного разу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的云端没有响应。现在游戏将使用这台 Mac 上的存档，下次再同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的雲端沒有回應。這次會使用這部 Mac 上的存檔，下次再同步。"
          }
        }
      }
    },
