    "%@ quits, and its saved login is removed from this Mac. Installed games stay; to play them, sign in again." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ закрыецца, а захаваны ўваход будзе выдалены з гэтага Mac. Усталяваныя гульні застануцца; каб гуляць, увайдзіце зноў."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird beendet und die gespeicherte Anmeldung von diesem Mac entfernt. Installierte Spiele bleiben; zum Spielen erneut anmelden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se cerrará y su inicio de sesión guardado se eliminará de este Mac. Los juegos instalados se quedan; para jugarlos, vuelve a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ va se fermer et sa connexion enregistrée sera supprimée de ce Mac. Les jeux installés restent ; pour y jouer, reconnectez-vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verrà chiuso e il suo accesso salvato sarà rimosso da questo Mac. I giochi installati restano; per giocarci, accedi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が終了し、保存されたログイン情報がこの Mac から削除されます。インストール済みのゲームは残ります。プレイするには再度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱이 종료되고 이 Mac에 저장된 로그인 정보가 삭제됩니다. 설치된 게임은 유지되며, 플레이하려면 다시 로그인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stopt en de bewaarde login wordt van deze Mac verwijderd. Geïnstalleerde games blijven; log opnieuw in om ze te spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zakończy działanie, a zapisane logowanie zniknie z tego Maca. Zainstalowane gry zostaną; aby w nie grać, zaloguj się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ será encerrado e o login salvo será removido deste Mac. Os jogos instalados continuam; para jogar, inicie sessão de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ закроется, а сохранённый вход будет удалён с этого Mac. Установленные игры останутся; чтобы играть, войдите снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ avslutas och den sparade inloggningen tas bort från den här Macen. Installerade spel finns kvar – logga in igen för att spela dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kapanır ve kayıtlı girişi bu Mac'ten silinir. Yüklü oyunlar kalır; oynamak için yeniden giriş yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ закриється, а збережений вхід буде видалено з цього Mac. Встановлені ігри залишаться; щоб грати, увійдіть знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将退出，其保存的登录信息会从这台 Mac 上移除。已安装的游戏会保留；要玩它们，请重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會結束，並從這部 Mac 移除儲存的登入資訊。已安裝的遊戲會保留；要玩時請重新登入。"
          }
        }
      }
    },
    "%@ runs in its own environment, like Steam. Sommelier downloads its official installer and sets it up; you sign in inside it." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ працуе ва ўласным асяроддзі, як Steam. Sommelier спампуе афіцыйны ўсталёўшчык і ўсё наладзіць; увайсці ў акаўнт трэба будзе ўнутры яго."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft wie Steam in einer eigenen Umgebung. Sommelier lädt den offiziellen Installer und richtet alles ein; anmelden können Sie sich dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ funciona en su propio entorno, como Steam. Sommelier descarga su instalador oficial y lo configura; tú inicias sesión dentro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tourne dans son propre environnement, comme Steam. Sommelier télécharge son installateur officiel et le configure ; vous vous connectez dedans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ funziona in un ambiente tutto suo, come Steam. Sommelier scarica il programma di installazione ufficiale e lo configura; l'accesso lo fai al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は Steam と同じく独自の環境で動作します。Sommelier が公式インストーラーをダウンロードして設定します。サインインはその中で行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱은 Steam처럼 자체 환경에서 실행됩니다. Sommelier가 공식 설치 프로그램을 다운로드해 설정하며, 로그인은 앱 안에서 하면 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ draait in een eigen omgeving, net als Steam. Sommelier downloadt de officiële installer en stelt alles in; je logt daarin zelf in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ działa we własnym środowisku, jak Steam. Sommelier pobierze oficjalny instalator i wszystko skonfiguruje; zalogujesz się już w nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ roda em um ambiente próprio, como o Steam. O Sommelier baixa o instalador oficial e configura tudo; você inicia sessão dentro dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ работает в собственном окружении, как Steam. Sommelier скачает официальный установщик и всё настроит; войти в аккаунт нужно будет внутри него."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ körs i en egen miljö, precis som Steam. Sommelier hämtar det officiella installationsprogrammet och ställer in allt. Du loggar in i appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Steam gibi kendi ortamında çalışır. Sommelier resmî yükleyiciyi indirip kurar; giriş işlemini onun içinde yaparsınız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ працює у власному середовищі, як Steam. Sommelier завантажить офіційний інсталятор і все налаштує; увійти в акаунт треба буде всередині нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在自己的环境中运行，和 Steam 一样。Sommelier 会下载官方安装程序并完成设置；您在其中登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 和 Steam 一樣在獨立環境中執行。Sommelier 會下載官方安裝程式並完成設定，只需在其中登入。"
          }
        }
      }
    },
