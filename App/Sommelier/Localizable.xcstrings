    "16 GB or more memory is recommended for demanding games." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для патрабавальных гульняў рэкамендуецца 16 ГБ памяці або больш."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für anspruchsvolle Spiele werden 16 GB Arbeitsspeicher oder mehr empfohlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para juegos exigentes se recomiendan 16 GB de memoria o más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16 Go de mémoire ou plus sont recommandés pour les jeux exigeants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i giochi pesanti sono consigliati 16 GB di memoria o più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負荷の高いゲームには16 GB以上のメモリをおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고사양 게임에는 16GB 이상의 메모리를 권장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor zware games wordt 16 GB geheugen of meer aanbevolen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do wymagających gier zalecane jest 16 GB pamięci lub więcej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para jogos pesados, recomenda-se 16 GB de memória ou mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для требовательных игр рекомендуется 16 ГБ памяти или больше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16 GB minne eller mer rekommenderas för krävande spel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorlu oyunlar için 16 GB veya daha fazla bellek önerilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для вимогливих ігор рекомендовано 16 ГБ пам’яті або більше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
