    "Games' ratings stop counting them. This can't be undone." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яны перастануць улічвацца ў ацэнках гульняў. Адмяніць гэта нельга."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie zählen dann nicht mehr für Spielbewertungen. Das lässt sich nicht widerrufen."
