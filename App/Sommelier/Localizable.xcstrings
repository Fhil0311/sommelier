    "Plug your Mac into the TV, pick up a controller and sit on the couch: the whole library in full screen, browsed with buttons." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Падключыце Mac да тэлевізара, вазьміце геймпад і сядайце на канапу: уся бібліятэка на ўвесь экран, гартаецца кнопкамі."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac an den Fernseher anschließen, Controller schnappen, aufs Sofa: die ganze Bibliothek im Vollbild, mit Tasten durchblättern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el Mac a la tele, coge un mando y siéntate en el sofá: toda la biblioteca a pantalla completa, manejada con botones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez votre Mac à la télé, prenez une manette et installez-vous sur le canapé : toute la bibliothèque en plein écran, parcourue avec les boutons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega il Mac alla TV, prendi un controller e mettiti sul divano: tutta la libreria a schermo intero, da sfogliare con i tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac をテレビにつなぎ、コントローラーを持ってソファへ。ライブラリ全体をフルスクリーンで、ボタンだけで操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac을 TV에 연결하고 컨트롤러를 들고 소파에 앉으세요. 전체 라이브러리를 전체 화면으로 버튼만으로 둘러볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit je Mac aan op de tv, pak een controller en ga op de bank zitten: de hele bibliotheek schermvullend, te bedienen met knoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłącz Maca do telewizora, weź pada i usiądź na kanapie: cała biblioteka na pełnym ekranie, przeglądana przyciskami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o Mac na TV, pegue um controle e sente no sofá: a biblioteca inteira em tela cheia, navegada por botões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите Mac к телевизору, возьмите геймпад и садитесь на диван: вся библиотека на весь экран, листается кнопками."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut Macen till tv:n, ta en handkontroll och sätt dig i soffan: hela biblioteket i helskärm, styrt med knappar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'inizi televizyona bağlayın, kumandayı alın ve kanepeye geçin: tüm kitaplık tam ekranda, düğmelerle gezilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть Mac до телевізора, візьміть геймпад і сідайте на диван: уся бібліотека на весь екран, гортається кнопками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 Mac 接到电视上，拿起手柄坐到沙发上：整个游戏库全屏显示，用按键浏览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 Mac 接上電視，拿起控制器窩進沙發：整個遊戲庫全螢幕顯示，用按鈕就能瀏覽。"
          }
        }
      }
    },
