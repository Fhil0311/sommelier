    "Cuts snap to the ticks (every 2 seconds), so the copy saves at once and loses no quality." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Краі стануць па метках (кожныя 2 секунды), таму копія захоўваецца адразу і без страты якасці."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnitte rasten an den Strichen ein (alle 2 Sekunden), so wird die Kopie sofort und ohne Qualitätsverlust gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cortes se ajustan a las marcas (cada 2 segundos), así la copia se guarda al instante y sin perder calidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coupes s'alignent sur les repères (toutes les 2 secondes) : la copie est enregistrée tout de suite, sans perte de qualité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tagli si agganciano alle tacche (ogni 2 secondi), così la copia si salva subito e senza perdere qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り取り位置は目盛り（2 秒ごと）に合わせられるため、コピーはすぐに画質を落とさず保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자르는 지점이 눈금(2초 간격)에 맞춰지므로 사본이 바로, 화질 손실 없이 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knippen gebeurt op de streepjes (elke 2 seconden), zodat de kopie meteen klaar is zonder kwaliteitsverlies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cięcia trafiają w znaczniki (co 2 sekundy), więc kopia zapisuje się od razu i bez utraty jakości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cortes se encaixam nas marcas (a cada 2 segundos), então a cópia é salva na hora e sem perder qualidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Края встают по меткам (каждые 2 секунды), поэтому копия сохраняется сразу и без потери качества."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klippen hamnar på markeringarna (varannan sekund), så kopian sparas direkt utan kvalitetsförlust."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesimler işaretlere (her 2 saniyede bir) oturur, böylece kopya hemen ve kalite kaybı olmadan kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Краї стають на позначки (кожні 2 секунди), тому копія зберігається одразу й без втрати якості."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪切点会对齐刻度（每 2 秒），因此副本会立即保存且不损失画质。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪切點會對齊刻度（每 2 秒），所以副本能立即儲存，且畫質不受損。"
          }
        }
      }
    },
