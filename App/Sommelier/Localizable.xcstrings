    "Steam is still starting. The first start takes longer." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam яшчэ запускаецца. Першы запуск займае больш часу."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam startet noch. Der erste Start dauert länger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam aún se está iniciando. La primera vez tarda más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam démarre encore. Le premier démarrage prend plus de temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam si sta ancora avviando. Il primo avvio richiede più tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steamはまだ起動中です。初回の起動には時間がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam이 아직 시작 중입니다. 처음 시작할 때는 더 오래 걸립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
