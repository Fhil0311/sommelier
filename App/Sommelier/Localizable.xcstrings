          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is bekend dat deze game niet start zonder Windows."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomo, że bez Windows się nie uruchamia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já se sabe que não abre sem Windows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Известно, что без Windows она не запускается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är känt att det inte startar utan Windows."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows olmadan başlamadığı biliniyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відомо, що без Windows вона не запускається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已知没有 Windows 无法启动。"
