    "Starts and plays well on Macs like this one." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускаецца і добра ідзе на такіх Mac, як гэты."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet und läuft gut auf Macs wie diesem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranca y va bien en Macs como este."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lance et tourne bien sur les Mac comme celui-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si avvia e gira bene su Mac come questo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このような Mac で起動し、快適に動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이와 같은 Mac에서 실행되고 잘 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start en loopt goed op Macs zoals deze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia się i działa dobrze na Macach takich jak ten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre e roda bem em Macs como este."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускается и хорошо идёт на таких Mac, как этот."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startar och går bra på Mac-datorer som den här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun gibi Mac'lerde açılır ve iyi çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускається й добре йде на таких Mac, як цей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在类似这台的 Mac 上能启动且运行流畅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在類似這台的 Mac 上能啟動且執行順暢。"
          }
        }
      }
    },
    "Starts by itself once your Mac is ready." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пачнецца сама, калі Mac будзе гатовы."
          }
