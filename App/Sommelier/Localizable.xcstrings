          }
        }
      }
    },
    "The game needs the Visual C++ runtime, which the environment doesn't have." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гульні патрэбны Visual C++ runtime, якога няма ў асяроддзі."
          }
        },
        "de" : {
          "stringUnit" : {
