    "Lets the game see this display as HDR, so HDR can be turned on in the game's own settings." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гульня ўбачыць, што экран падтрымлівае HDR, і яго можна будзе ўключыць у наладах самой гульні."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel erkennt diesen Bildschirm als HDR-fähig, sodass sich HDR in den Einstellungen des Spiels einschalten lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego verá esta pantalla como HDR, así podrás activar HDR en sus propios ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu voit cet écran comme HDR, pour que vous puissiez activer le HDR dans ses propres paramètres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gioco vede questo schermo come HDR, così puoi attivare l'HDR nelle sue impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームにこのディスプレイを HDR 対応として伝えます。HDR はゲーム内の設定でオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임이 이 디스플레이를 HDR로 인식해, 게임 설정에서 HDR을 켤 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De game ziet dit scherm als HDR, zodat je HDR kunt aanzetten in de instellingen van de game zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gra zobaczy ten ekran jako HDR, więc HDR da się włączyć w jej ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo passa a ver esta tela como HDR, e você pode ativar o HDR nos ajustes do próprio jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра увидит, что экран поддерживает HDR, и его можно будет включить в настройках самой игры."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter spelet se skärmen som HDR, så att HDR kan slås på i spelets egna inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun bu ekranı HDR olarak görür; böylece HDR, oyunun kendi ayarlarından açılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гра побачить, що екран підтримує HDR, і його можна буде ввімкнути в налаштуваннях самої гри."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让游戏识别此显示器支持 HDR，之后可在游戏自身的设置中开启 HDR。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓遊戲將此顯示器視為 HDR，即可在遊戲本身的設定中開啟 HDR。"
          }
        }
      }
    },
