    "Now Sommelier also shares which stores and features you use." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цяпер Sommelier таксама дзеліцца тым, якімі крамамі і функцыямі вы карыстаецеся."
          }
        },
        "de" : {
          "stringUnit" : {
