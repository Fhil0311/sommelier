          "stringUnit" : {
            "state" : "translated",
            "value" : "已知沒有 Windows 就無法啟動。"
          }
        }
      }
    },
    "It's online-only, and its anti-cheat blocks Macs." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гульня толькі анлайн, а яе антычыт не пускае Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist nur online spielbar, und sein Anti-Cheat sperrt Macs aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es solo online y su antitrampas bloquea los Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est uniquement en ligne, et son anti-triche bloque les Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È solo online e il suo anti-cheat blocca i Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンライン専用で、アンチチートが Mac をブロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인 전용이며, 안티치트가 Mac을 차단합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen online te spelen, en de anticheat blokkeert Macs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa tylko online, a jej anti-cheat blokuje Maki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É só online, e o anti-cheat bloqueia Macs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра только сетевая, а её защита от читеров не пускает Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan bara spelas online, och fuskskyddet blockerar Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca çevrimiçi oynanıyor ve hile önleyicisi Mac'leri engelliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гра лише онлайн, а її античит не пускає Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
