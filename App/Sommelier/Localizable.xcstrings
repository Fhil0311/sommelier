          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna %@, logga in och installera ett spel där. Det visas här automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uygulamasını açın, giriş yapın ve oradan bir oyun yükleyin. Oyun burada kendiliğinden görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
