    "Didn't start" : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не запусцілася"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gestartet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No arrancó"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne s'est pas lancé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si è avviato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動しなかった"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 실패"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet gestart"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie uruchomiła się"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não abriu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не запустилась"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startade inte"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlamadı"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не запустилася"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能启动"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有啟動"
          }
        }
      }
    },
    "Direct3D 11 failed to start on Wine's own graphics. DXMT runs Direct3D 11 on Metal and works for most games." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 не запусціўся на ўбудаванай графіцы Wine. DXMT перакладае Direct3D 11 на Metal і працуе ў большасці гульняў."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 startet nicht mit der eigenen Grafik von Wine. DXMT übersetzt Direct3D 11 in Metal und funktioniert mit den meisten Spielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 no arrancó con los gráficos propios de Wine. DXMT ejecuta Direct3D 11 sobre Metal y funciona con la mayoría de los juegos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 n'a pas pu démarrer avec le rendu graphique de Wine. DXMT fait tourner Direct3D 11 sur Metal et marche avec la plupart des jeux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 non è partito con la grafica integrata di Wine. DXMT esegue Direct3D 11 su Metal e funziona con quasi tutti i giochi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine 内蔵のグラフィックスで Direct3D 11 を起動できませんでした。DXMT は Direct3D 11 を Metal 上で動かし、ほとんどのゲームで動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wine 자체 그래픽에서 Direct3D 11을 시작하지 못했습니다. DXMT는 Direct3D 11을 Metal에서 실행하며 대부분의 게임에서 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 kon niet starten op de eigen graphics van Wine. DXMT draait Direct3D 11 op Metal en werkt voor de meeste games."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 nie uruchomił się na grafice wbudowanej w Wine. DXMT przekłada Direct3D 11 na Metal i działa w większości gier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Direct3D 11 não iniciou com os gráficos do próprio Wine. O DXMT roda Direct3D 11 sobre Metal e funciona na maioria dos jogos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 не запустился на встроенной графике Wine. DXMT переводит Direct3D 11 в Metal и работает в большинстве игр."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 kunde inte starta med Wines egen grafik. DXMT kör Direct3D 11 på Metal och fungerar med de flesta spel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11, Wine'ın kendi grafikleriyle başlatılamadı. DXMT, Direct3D 11'i Metal üzerinde çalıştırır ve çoğu oyunda işe yarar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 не запустився на вбудованій графіці Wine. DXMT перекладає Direct3D 11 на Metal і працює в більшості ігор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 无法在 Wine 自带的图形层上启动。DXMT 在 Metal 上运行 Direct3D 11，适用于大多数游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct3D 11 無法在 Wine 內建的圖形層上啟動。DXMT 會在 Metal 上執行 Direct3D 11，適用大多數遊戲。"
          }
        }
      }
    },
