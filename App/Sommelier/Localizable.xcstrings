    "Never your name, accounts, files or what's on screen. Nothing identifies you." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ніколі — ваша імя, акаўнты, файлы ці тое, што на экране. Нішто не ўказвае на вас."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemals Ihr Name, Ihre Accounts, Dateien oder Bildschirminhalte. Nichts lässt auf Sie schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca tu nombre, cuentas, archivos ni lo que hay en pantalla. Nada te identifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais votre nom, vos comptes, vos fichiers ni ce qui est à l'écran. Rien ne permet de vous identifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai il tuo nome, i tuoi account, i tuoi file o ciò che c'è sullo schermo. Niente ti identifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前、アカウント、ファイル、画面の内容は送りません。あなたを特定する情報はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름, 계정, 파일, 화면 내용은 절대 보내지 않습니다. 개인을 식별할 수 있는 정보는 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nooit je naam, accounts, bestanden of wat er op het scherm staat. Niets is naar jou te herleiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy twoje imię, konta, pliki ani to, co na ekranie. Nic, co by cię identyfikowało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca seu nome, contas, arquivos ou o que está na tela. Nada identifica você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда — ваше имя, аккаунты, файлы или то, что на экране. Ничто не указывает на вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldrig ditt namn, konton, filer eller vad som visas på skärmen. Inget identifierar dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adınız, hesaplarınız, dosyalarınız ya da ekrandakiler asla gönderilmez. Hiçbir şey sizi tanımlamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ніколи — ваше ім’я, акаунти, файли чи те, що на екрані. Ніщо не вказує на вас."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不包括你的姓名、账户、文件或屏幕内容。不会暴露你的身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不會傳送你的名稱、帳號、檔案或螢幕上的內容。沒有任何資訊能識別你的身分。"
          }
        }
      }
    },
