    "If a game crashes, the last 30 seconds before it are saved on their own." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі гульня выляціць, апошнія 30 секунд перад гэтым захаваюцца самі."
          }
        },
        "de" : {
          "stringUnit" : {
