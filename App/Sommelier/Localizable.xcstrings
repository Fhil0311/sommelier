        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game Porting Toolkit에 대한 Apple 라이선스가 적용됩니다. Apple 웹 사이트에서 이미 동의했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De licentie van Apple voor de Game Porting Toolkit is van toepassing. Je hebt die geaccepteerd op de website van Apple."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
