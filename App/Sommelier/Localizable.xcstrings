    "Apple's license for the Game Porting Toolkit applies. You accepted it on Apple's website." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дзейнічае ліцэнзія Apple на Game Porting Toolkit. Вы прынялі яе на сайце Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gilt Apples Lizenz für das Game Porting Toolkit. Sie haben ihr auf der Website von Apple zugestimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica la licencia de Apple para Game Porting Toolkit. La aceptaste en la web de Apple."
