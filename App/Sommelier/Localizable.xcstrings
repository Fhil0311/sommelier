        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %1$@ 的這份遊戲有 Mac 版本。從 %2$@ 下載即可原生遊玩。"
          }
        }
      }
    },
    "Your %@ games appear here. They download straight to this Mac, no launcher needed." : {
