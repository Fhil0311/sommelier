    "Press %@ in the game to save the last %lld seconds." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Націсніце %@ у гульні, каб захаваць апошнія %lld с."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie im Spiel %@, um die letzten %lld Sekunden zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %@ en el juego para guardar los últimos %lld segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %@ en jeu pour garder les %lld dernières secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi %@ nel gioco per salvare gli ultimi %lld secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム中に %@ を押すと直前 %lld 秒を保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임에서 %@ 키를 누르면 최근 %lld초를 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk in de game op %@ om de laatste %lld seconden te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij %@ w grze, aby zapisać ostatnie %lld s."
