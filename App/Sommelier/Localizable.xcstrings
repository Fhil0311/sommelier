          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre besten Momente und was schiefging – aus Ihren Spielen gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus mejores momentos y lo que salió mal, guardados de tus juegos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos meilleurs moments et vos ratés, enregistrés depuis vos jeux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi momenti migliori e quelli andati storti, salvati dai tuoi giochi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームから保存した、最高の瞬間とうまくいかなかった瞬間。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임에서 저장한 최고의 순간과 일이 꼬인 순간."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je beste momenten en wat er misging, bewaard uit je games."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje najlepsze momenty i to, co poszło nie tak, zapisane z gier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus melhores momentos e o que deu errado, salvos dos seus jogos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучшие моменты и то, что пошло не так, сохранённые из ваших игр."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina bästa ögonblick och det som gick fel, sparade från dina spel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi anlarınız ve ters gidenler, oyunlarınızdan kaydedildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найкращі моменти і те, що пішло не так, збережені з ваших ігор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从你的游戏中保存的高光时刻和翻车瞬间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從遊戲中保存的精彩時刻和翻車瞬間。"
          }
        }
      }
    },
