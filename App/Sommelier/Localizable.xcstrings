    "Start a game and press %@ when something worth keeping happens. The last %lld seconds become a clip and show up here." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запусціце гульню і націсніце %@, калі здарыцца штосьці вартае. Апошнія %lld с стануць кліпам і з’явяцца тут."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starten Sie ein Spiel und drücken Sie %@, wenn etwas Sehenswertes passiert. Die letzten %lld Sekunden werden zum Clip und erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un juego y pulsa %@ cuando pase algo que valga la pena. Los últimos %lld segundos se convierten en un clip y aparecen aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez un jeu et appuyez sur %@ quand il se passe quelque chose à garder. Les %lld dernières secondes deviennent un clip et apparaissent ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia un gioco e premi %@ quando succede qualcosa da tenere. Gli ultimi %lld secondi diventano una clip e compaiono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームを起動し、残したい場面で %@ を押してください。直前 %lld 秒がクリップになり、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임을 시작하고 남기고 싶은 장면에서 %@ 키를 누르십시오. 최근 %lld초가 클립이 되어 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start een game en druk op %@ als er iets gebeurt wat je wilt bewaren. De laatste %lld seconden worden een clip en verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom grę i naciśnij %@, gdy wydarzy się coś wartego zapisania. Ostatnie %lld s zamieni się w klip i pojawi się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra um jogo e pressione %@ quando algo legal acontecer. Os últimos %lld segundos viram um clipe e aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустите игру и нажмите %@, когда случится что-то стоящее. Последние %lld секунд станут клипом и появятся здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta ett spel och tryck på %@ när något värt att spara händer. De senaste %lld sekunderna blir ett klipp och visas här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oyun başlatın ve saklamaya değer bir şey olunca %@ tuşuna basın. Son %lld saniye klip olur ve burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустіть гру й натисніть %@, коли станеться щось варте уваги. Останні %lld с стануть кліпом і з’являться тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动游戏，遇到值得保留的时刻按下 %@。最近 %lld 秒会变成剪辑并显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動遊戲，遇到值得保留的時刻就按 %@。最後 %lld 秒會變成剪輯並顯示在這裡。"
          }
        }
      }
    },
