        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цій грі потрібен DirectX 12. Налаштуйте його один раз, і запустяться всі ігри на DirectX 12."
          }
        },
        "zh-Hans" : {
