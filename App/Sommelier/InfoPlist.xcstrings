        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier nagrywa dźwięk gry do klipów. Nagrywana jest tylko gra i nic nie opuszcza tego Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sommelier grava o som do jogo para os clipes. Só o jogo é gravado, e nada sai deste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier записывает звук игры для клипов. Записывается только игра, и ничего не уходит с этого Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier spelar in spelets ljud för klipp. Bara spelet spelas in, och inget lämnar den här Macen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier klipler için oyunun sesini kaydeder. Yalnızca oyun kaydedilir ve hiçbir şey bu Mac'ten çıkmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier записує звук гри для кліпів. Записується лише гра, і нічого не залишає цей Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier 为剪辑录制游戏声音。只录制游戏，任何内容都不会离开这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier 會為剪輯錄製遊戲聲音。只錄製遊戲，任何內容都不會離開這台 Mac。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "macOS asks for speech recognition with this (voice search in Controller Mode)",
      "extractionState" : "manual",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier ператварае сказанае ў пошук па вашых гульнях."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier macht aus dem, was Sie sagen, eine Suche nach Ihren Spielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier turns what you say into a search for your games."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier convierte lo que dices en una búsqueda de tus juegos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier transforme ce que vous dites en recherche dans vos jeux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier trasforma quello che dici in una ricerca tra i tuoi giochi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier は話した内容をゲームの検索に使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier가 말한 내용을 게임 검색에 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier maakt van wat je zegt een zoekopdracht in je games."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier zamienia to, co mówisz, w wyszukiwanie wśród twoich gier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sommelier transforma o que você fala em uma busca nos seus jogos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier превращает сказанное в поиск по вашим играм."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier gör det du säger till en sökning bland dina spel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier söylediklerinizi oyunlarınızda bir aramaya dönüştürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier перетворює сказане на пошук серед ваших ігор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier 将你说的话转为游戏搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommelier 會把你說的話轉成遊戲搜尋。"
          }
        }
      }
