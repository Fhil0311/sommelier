+/* Sommelier: arguments a program gets on top of its own, for programs a store starts that can't be given any (a
+ * game started by Ubisoft Connect or the EA app). The table named by SOMMELIER_EXE_ARGS has one
+ * "C:\Games\WD2\bin\WatchDogs2.exe<TAB>-eac_launcher -nosplash" per line: a program's full path, compared without
+ * case, and what to add. An argument already on the command line isn't added twice. Returns a new command line
+ * (the old one with the arguments after it), or NULL. */
+static WCHAR *sommelier_arguments( const UNICODE_STRING *image, const UNICODE_STRING *cmdline )
+{
+    const char *table = getenv( "SOMMELIER_EXE_ARGS" );
+    char line[2048], *path, *name, *args = NULL, *tab, *end, *arg, *next;
+    WCHAR *ret, *argw;
+    size_t len, cmd_len, pos;
+    FILE *f;
+
+    if (!table || !*table || !image->Buffer || !image->Length || !cmdline->Buffer) return NULL;
+    if (!(f = fopen( table, "r" ))) return NULL;
+    len = image->Length / sizeof(WCHAR) * 3 + 1;
+    if (!(path = malloc( len ))) { fclose( f ); return NULL; }
+    len = ntdll_wcstoumbs( image->Buffer, image->Length / sizeof(WCHAR), path, len - 1, FALSE );
+    path[len] = 0;
+    name = path;
+    if (!strncmp( name, "\\??\\", 4 )) name += 4;
+    while (!args && fgets( line, sizeof(line), f ))
+    {
+        if ((end = strpbrk( line, "\r\n" ))) *end = 0;
+        if (!(tab = strchr( line, '\t' ))) continue;
+        *tab++ = 0;
+        if (*tab && !strcasecmp( line, name )) args = strdup( tab );
+    }
+    fclose( f );
+    free( path );
+    if (!args) return NULL;
+
+    cmd_len = cmdline->Length / sizeof(WCHAR);
+    if (!(ret = malloc( (cmd_len + strlen( args ) + 2) * sizeof(WCHAR) ))) { free( args ); return NULL; }
+    memcpy( ret, cmdline->Buffer, cmd_len * sizeof(WCHAR) );
+    pos = cmd_len;
+    for (arg = args; arg && *arg; arg = next)
+    {
+        size_t arg_len, i;
+        BOOL present = FALSE;
+        while (*arg == ' ') arg++;
+        if (!*arg) break;
+        next = strchr( arg, ' ' );
+        arg_len = next ? (size_t)(next - arg) : strlen( arg );
+        if (!(argw = malloc( (arg_len + 1) * sizeof(WCHAR) ))) break;
+        arg_len = ntdll_umbstowcs( arg, arg_len, argw, arg_len );
+        argw[arg_len] = 0;
+        /* already there as a whole word: leave it */
+        for (i = 0; i + arg_len <= cmd_len && !present; i++)
+            present = !wcsnicmp( ret + i, argw, arg_len ) && (i == 0 || ret[i - 1] == ' ' || ret[i - 1] == '"')
+                      && (i + arg_len == cmd_len || ret[i + arg_len] == ' ' || ret[i + arg_len] == '"');
+        if (!present)
+        {
+            ret[pos++] = ' ';
+            memcpy( ret + pos, argw, arg_len * sizeof(WCHAR) );
+            pos += arg_len;
+        }
+        free( argw );
+    }
+    ret[pos] = 0;
+    free( args );
+    return ret;
+}
 
