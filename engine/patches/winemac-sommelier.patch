--- a/dlls/winemac.drv/framestats.c
+++ b/dlls/winemac.drv/framestats.c
@@ -0,0 +1,332 @@
+/*
+ * Frame statistics for Sommelier's compatibility reports
+ *
+ * Added by the Sommelier project, 2026 (LGPL-2.1-or-later, as the rest of Wine).
+ *
+ * Counts the frames a game presents through the driver's Metal layer (D3DMetal, DXMT, anything Metal) without
+ * drawing anything, and every 10 seconds writes the totals for Sommelier to read after the session:
+ *
+ *   $SOMMELIER_FRAME_STATS_DIR/<exe>-<pid>-metal.txt   (the variable is a Windows path, Z:\...)
+ *
+ *   exe=Game.exe, frames=, seconds=, average=, low1=, width=, height=   (one per line)
+ *
+ * `average` is frames per second over the time measured; `low1` is the frame rate of the slowest 1% of frames.
+ * The first 40 seconds (loading, shader building) and gaps of a second or more are left out. Each Metal layer is
+ * counted on its own (a game may have more than one); the busiest one is written, on a thread of its own.
+ *
+ * For Sommelier's in-game counter, the current frame rate also goes, twice a second, into a small shared file
+ * that Sommelier reads without the game ever waiting on it:
+ *
+ *   $SOMMELIER_FRAME_STATS_DIR/<exe>-<pid>-live.bin   (struct live_frame_rate below, 64 bytes)
+ *
+ * It is written with a sequence number (odd while writing), so a reader that sees an odd or changed number reads
+ * again. OpenGL games are counted too (macdrv_flush_opengl_context).
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <fcntl.h>
+#include <pthread.h>
+#include <sys/mman.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "macdrv.h"
+
+#define BIN_MS      0.25
+#define BINS        4000            /* up to 1 second */
+#define MAX_LAYERS  4
+#define SKIP_NS     40000000000ull
+#define WRITE_NS    10000000000ull
+#define LIVE_NS     500000000ull
+
+/* The shared file Sommelier's counter reads. Fixed layout: little-endian, 64 bytes. */
+struct live_frame_rate
+{
+    unsigned int magic;              /* 'SMLV' */
+    unsigned int version;            /* 1 */
+    volatile unsigned int sequence;  /* odd while being written */
+    unsigned int width, height;
+    float fps;                       /* over the last half second */
+    float frame_ms;                  /* average frame time over it */
+    float max_ms;                    /* slowest frame in it */
+    double updated;                  /* seconds since 1970 */
+    unsigned long long frames;       /* every frame counted since start */
+    char reserved[16];
+};
+
+struct layer_stats
+{
+    const void *layer;
+    unsigned long long last_drawable;      /* the drawable counted last: one may be presented through two paths */
+    int path;                              /* the present path that counts on this layer (the first one seen) */
+    unsigned long long first, last, last_write;
+    unsigned long long frames;
+    double seconds;
+    unsigned long long live_start, live_frames, all_frames;   /* the current half second, and every frame */
+    double live_ms, live_max;
+    unsigned int width, height;
+    unsigned int histogram[BINS];
+};
+
+static pthread_mutex_t stats_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct layer_stats *layers[MAX_LAYERS];
+static int state;                    /* 0 not set up yet, 1 on, -1 off */
+static char path[4096];
+static char live_path[4096];
+static struct live_frame_rate *live;          /* mapped by the writer thread once there are frames */
+static int live_wanted;
+static char exe[256];
+
+static unsigned long long now_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+/***********************************************************************
+ *              macdrv_framestats_init
+ *
+ * Called once at driver start-up, on a Wine thread: frames often arrive on Metal's own threads, where Wine's
+ * process data (the executable's name) can't be read.
+ */
+void macdrv_framestats_init(void)
+{
+    const char *dir = getenv("SOMMELIER_FRAME_STATS_DIR");
+    const WCHAR *name, *p;
+    char unix_dir[4096];
+    size_t i, n = 0;
+
+    state = -1;
+    if (!dir || !*dir) return;
+    name = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+    if (!name) return;
+    /* Z:\Users\me\... -> /Users/me/... */
+    if ((dir[0] == 'Z' || dir[0] == 'z') && dir[1] == ':') dir += 2;
+    for (i = 0; dir[i] && i < sizeof(unix_dir) - 1; i++) unix_dir[i] = dir[i] == '\\' ? '/' : dir[i];
+    unix_dir[i] = 0;
+    if (i && unix_dir[i - 1] == '/') unix_dir[i - 1] = 0;
+
+    if ((p = wcsrchr(name, '\\'))) name = p + 1;
+    if ((p = wcsrchr(name, '/'))) name = p + 1;
+    for (; *name && n < sizeof(exe) - 1; name++) exe[n++] = (*name < 0x80 && *name != '/') ? (char)*name : '_';
+    exe[n] = 0;
+    if (!n) return;
+
+    snprintf(path, sizeof(path), "%s/%s-%d-metal.txt", unix_dir, exe, (int)getpid());
+    snprintf(live_path, sizeof(live_path), "%s/%s-%d-live.bin", unix_dir, exe, (int)getpid());
+    state = 1;
+}
+
+static double percentile_ms(const struct layer_stats *s, double fraction)
+{
+    unsigned long long target = (unsigned long long)(s->frames * fraction), seen = 0;
+    int i;
+    for (i = 0; i < BINS; i++)
+    {
+        seen += s->histogram[i];
+        if (seen > target) return (i + 0.5) * BIN_MS;
+    }
+    return BINS * BIN_MS;
+}
+
+/* The file is written on a thread of its own, so the thread that presents frames never waits for the disk: it
+ * only formats the text (a few hundred bytes) and hands it over. */
+static pthread_mutex_t writer_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t writer_cond = PTHREAD_COND_INITIALIZER;
+static char pending[512];
+static int has_pending, writer_started;
+
+static void *writer_thread(void *arg)
+{
+    char text[sizeof(pending)];
+    FILE *file;
+
+    for (;;)
+    {
+        int map_live, write_text;
+
+        pthread_mutex_lock(&writer_mutex);
+        while (!has_pending && !(live_wanted && !live)) pthread_cond_wait(&writer_cond, &writer_mutex);
+        write_text = has_pending;
+        map_live = live_wanted && !live;
+        if (write_text) memcpy(text, pending, sizeof(text));
+        has_pending = 0;
+        pthread_mutex_unlock(&writer_mutex);
+
+        if (map_live)
+        {
+            struct live_frame_rate *map = MAP_FAILED;
+            int fd = open(live_path, O_RDWR | O_CREAT | O_TRUNC, 0644);
+            if (fd >= 0)
+            {
+                if (ftruncate(fd, sizeof(*map)) == 0)
+                    map = mmap(NULL, sizeof(*map), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+                close(fd);
+            }
+            pthread_mutex_lock(&writer_mutex);
+            if (map != MAP_FAILED)
+            {
+                memset(map, 0, sizeof(*map));
+                map->magic = 0x564c4d53;   /* "SMLV" */
+                map->version = 1;
+                __atomic_store_n(&live, map, __ATOMIC_RELEASE);
+            }
+            else live_wanted = 0;          /* can't: don't try again */
+            pthread_mutex_unlock(&writer_mutex);
+        }
+        if (!write_text) continue;
+        if (!(file = fopen(path, "w"))) continue;
+        fputs(text, file);
+        fclose(file);
+    }
+    return NULL;
+}
+
+/* Starts the writer thread if needed and wakes it. Called with writer_mutex held. */
+static void wake_writer(void)
+{
+    pthread_t thread;
+    if (!writer_started)
+    {
+        if (pthread_create(&thread, NULL, writer_thread, NULL) == 0)
+        {
+            pthread_detach(thread);
+            writer_started = 1;
+        }
+        else { state = -1; return; }   /* no thread, no statistics: never write on the presenting thread */
+    }
+    pthread_cond_signal(&writer_cond);
+}
+
+/* Twice a second: the busiest layer's last half second into the shared file (no system calls here). */
+static void publish_live(struct layer_stats *s, unsigned long long now)
+{
+    struct live_frame_rate *map = __atomic_load_n(&live, __ATOMIC_ACQUIRE);
+    struct timespec ts;
+    double elapsed = (now - s->live_start) / 1e9;
+    int i;
+
+    for (i = 0; i < MAX_LAYERS; i++)          /* another layer is busier: it publishes */
+        if (layers[i] && layers[i] != s && layers[i]->live_frames > s->live_frames
+            && now - layers[i]->live_start < 2 * LIVE_NS) goto reset;
+    if (!map)
+    {
+        if (!live_wanted)
+        {
+            pthread_mutex_lock(&writer_mutex);
+            live_wanted = 1;
+            wake_writer();
+            pthread_mutex_unlock(&writer_mutex);
+        }
+        goto reset;
+    }
+    clock_gettime(CLOCK_REALTIME, &ts);
+    __atomic_add_fetch(&map->sequence, 1, __ATOMIC_ACQ_REL);
+    map->width = s->width;
+    map->height = s->height;
+    map->fps = elapsed > 0 ? (float)(s->live_frames / elapsed) : 0;
+    map->frame_ms = s->live_frames ? (float)(s->live_ms / s->live_frames) : 0;
+    map->max_ms = (float)s->live_max;
+    map->updated = ts.tv_sec + ts.tv_nsec / 1e9;
+    map->frames = s->all_frames;
+    __atomic_add_fetch(&map->sequence, 1, __ATOMIC_ACQ_REL);
+
+reset:
+    s->live_start = now;
+    s->live_frames = 0;
+    s->live_ms = s->live_max = 0;
+}
+
+static void write_stats(void)
+{
+    struct layer_stats *best = NULL;
+    double slow;
+    int i;
+
+    for (i = 0; i < MAX_LAYERS; i++)
+        if (layers[i] && layers[i]->frames && (!best || layers[i]->frames > best->frames)) best = layers[i];
+    if (!best || best->seconds <= 0) return;
+    slow = percentile_ms(best, 0.99);
+
+    pthread_mutex_lock(&writer_mutex);
+    snprintf(pending, sizeof(pending), "exe=%s\nframes=%llu\nseconds=%.1f\naverage=%.1f\nlow1=%.1f\nwidth=%u\nheight=%u\n",
+             exe, best->frames, best->seconds, best->frames / best->seconds, slow > 0 ? 1000.0 / slow : 0,
+             best->width, best->height);
+    has_pending = 1;
+    wake_writer();
+    pthread_mutex_unlock(&writer_mutex);
+}
+
+/***********************************************************************
+ *              macdrv_frame_presented
+ *
+ * Called when a frame is presented: `drawable` is its drawableID (0 when unknown), `path` which way it was shown
+ * (a command buffer's presentDrawable, a Metal 4 queue, the drawable's own present, OpenGL). A frame can pass through
+ * two of them (D3DMetal's command buffer presents the drawable, which presents itself), several frames in flight
+ * at once, so only the first path seen on a layer counts there: comparing drawables alone let every frame count twice.
+ */
+void macdrv_frame_presented(const void *layer, unsigned long long drawable, unsigned int width, unsigned int height,
+                            int path)
+{
+    unsigned long long now;
+    struct layer_stats *s = NULL;
+    double ms;
+    int i;
+
+    if (state <= 0) return;                /* off, or before start-up */
+    now = now_ns();
+    pthread_mutex_lock(&stats_mutex);
+
+    for (i = 0; i < MAX_LAYERS && layers[i]; i++)
+        if (layers[i]->layer == layer) { s = layers[i]; break; }
+    if (!s)
+    {
+        if (i == MAX_LAYERS || !(s = calloc(1, sizeof(*s)))) goto done;
+        s->layer = layer;
+        s->path = path;
+        s->last_drawable = drawable;
+        s->first = s->last = s->last_write = s->live_start = now;
+        layers[i] = s;
+        goto done;
+    }
+
+    if (path != s->path) goto done;
+    if (drawable && drawable == s->last_drawable) goto done;
+    s->last_drawable = drawable;
+    ms = (now - s->last) / 1e6;
+    s->last = now;
+    if (width && height) { s->width = width; s->height = height; }
+
+    /* The live counter: every frame, from the start (loading screens included). */
+    s->all_frames++;
+    if (ms > 0 && ms < 1000)
+    {
+        s->live_frames++;
+        s->live_ms += ms;
+        if (ms > s->live_max) s->live_max = ms;
+    }
+    if (now - s->live_start >= LIVE_NS) publish_live(s, now);
+
+    if (now - s->first < SKIP_NS || ms <= 0 || ms >= 1000) goto done;
+    i = (int)(ms / BIN_MS);
+    s->histogram[i < BINS ? i : BINS - 1]++;
+    s->frames++;
+    s->seconds += ms / 1000;
+    if (now - s->last_write >= WRITE_NS)
+    {
+        s->last_write = now;
+        write_stats();
+    }
+
+done:
+    pthread_mutex_unlock(&stats_mutex);
+}
