+/* Sommelier: count every frame a process shows, whoever draws it (D3DMetal, DXMT, anything Metal), for the frame
+ * statistics (framestats.c). A frame reaches the screen through a command buffer's presentDrawable methods, a Metal 4
+ * queue's signalDrawable:, or the drawable's own present methods; it can pass through more than one of them, so each
+ * drawable (by its drawableID, or the object when that is 0; per layer) counts once. */
+static void count_drawable(id drawable, int path)
+{
+    CAMetalLayer *layer;
+    CGSize size;
+    NSUInteger drawable_id;
+
+    if (!drawable || ![drawable respondsToSelector:@selector(layer)]) return;
+    layer = [(id<CAMetalDrawable>)drawable layer];
+    size = layer ? layer.drawableSize : CGSizeZero;
+    drawable_id = [drawable respondsToSelector:@selector(drawableID)] ? [(id<MTLDrawable>)drawable drawableID] : 0;
+    if (!drawable_id) drawable_id = (NSUInteger)drawable;     /* D3DMetal's drawables report 0: tell them apart by object */
+    macdrv_frame_presented(layer ? (const void *)layer : (const void *)drawable, drawable_id,
+                           (unsigned int)size.width, (unsigned int)size.height, path);
+}
+
+static void swap_in(Class target, Class source, const char *selector, const char *replacement)
+{
+    Method original, counted;
+    if (!target) return;
+    original = class_getInstanceMethod(target, sel_registerName(selector));
+    counted = class_getInstanceMethod(source, sel_registerName(replacement));
+    if (!original || !counted) return;
+    /* Give the class the counting method, then swap the two on it. */
+    if (class_addMethod(target, sel_registerName(replacement), method_getImplementation(counted), method_getTypeEncoding(counted)))
+        method_exchangeImplementations(original, class_getInstanceMethod(target, sel_registerName(replacement)));
+}
+
+@interface NSObject (SommelierFrameStats)
+@end
+
+@implementation NSObject (SommelierFrameStats)
+
+    + (void) load
+    {
+        Class buffer = NSClassFromString(@"_MTLCommandBuffer");
+        Class queue4 = NSClassFromString(@"_MTL4CommandQueue");
+        Class drawable = NSClassFromString(@"CAMetalDrawable");
+
+        if (self != [NSObject class]) return;
+        swap_in(buffer, self, "presentDrawable:", "sommelier_presentDrawable:");
+        swap_in(buffer, self, "presentDrawable:atTime:", "sommelier_presentDrawable:atTime:");
+        swap_in(buffer, self, "presentDrawable:afterMinimumDuration:", "sommelier_presentDrawable:afterMinimumDuration:");
+        swap_in(buffer, self, "presentDrawable:options:", "sommelier_presentDrawable:options:");
+        swap_in(queue4, self, "signalDrawable:", "sommelier_signalDrawable:");
+        swap_in(drawable, self, "present", "sommelier_present");
+        swap_in(drawable, self, "presentAtTime:", "sommelier_presentAtTime:");
+        swap_in(drawable, self, "presentAfterMinimumDuration:", "sommelier_presentAfterMinimumDuration:");
+        swap_in(drawable, self, "presentWithOptions:", "sommelier_presentWithOptions:");
+    }
+
+    - (void) sommelier_presentDrawable:(id)d { count_drawable(d, 1); [self sommelier_presentDrawable:d]; }
+    - (void) sommelier_presentDrawable:(id)d atTime:(CFTimeInterval)t { count_drawable(d, 1); [self sommelier_presentDrawable:d atTime:t]; }
+    - (void) sommelier_presentDrawable:(id)d afterMinimumDuration:(CFTimeInterval)t { count_drawable(d, 1); [self sommelier_presentDrawable:d afterMinimumDuration:t]; }
+    - (void) sommelier_presentDrawable:(id)d options:(id)o { count_drawable(d, 1); [self sommelier_presentDrawable:d options:o]; }
+    - (void) sommelier_signalDrawable:(id)d { count_drawable(d, 2); [self sommelier_signalDrawable:d]; }
+    - (void) sommelier_present { count_drawable(self, 3); [self sommelier_present]; }
+    - (void) sommelier_presentAtTime:(CFTimeInterval)t { count_drawable(self, 3); [self sommelier_presentAtTime:t]; }
+    - (void) sommelier_presentAfterMinimumDuration:(CFTimeInterval)t { count_drawable(self, 3); [self sommelier_presentAfterMinimumDuration:t]; }
+    - (void) sommelier_presentWithOptions:(id)o { count_drawable(self, 3); [self sommelier_presentWithOptions:o]; }
+
+@end
+
