+static unsigned int client_surface_hwnd_count;
+
+static void client_surface_hwnd_add(HWND hwnd)
+{
+    pthread_mutex_lock(&client_surface_hwnds_mutex);
+    if (client_surface_hwnd_count < ARRAY_SIZE(client_surface_hwnds))
+        client_surface_hwnds[client_surface_hwnd_count++] = hwnd;
+    pthread_mutex_unlock(&client_surface_hwnds_mutex);
+}
+
+static void client_surface_hwnd_remove(HWND hwnd)
+{
+    unsigned int i;
+    pthread_mutex_lock(&client_surface_hwnds_mutex);
+    for (i = 0; i < client_surface_hwnd_count; i++)
+    {
+        if (client_surface_hwnds[i] != hwnd) continue;
+        client_surface_hwnds[i] = client_surface_hwnds[--client_surface_hwnd_count];
+        break;
+    }
+    pthread_mutex_unlock(&client_surface_hwnds_mutex);
+}
+
+static BOOL hwnd_has_client_surface(HWND hwnd)
+{
+    unsigned int i;
+    BOOL found = FALSE;
+    pthread_mutex_lock(&client_surface_hwnds_mutex);
+    for (i = 0; i < client_surface_hwnd_count && !found; i++) found = client_surface_hwnds[i] == hwnd;
+    pthread_mutex_unlock(&client_surface_hwnds_mutex);
+    return found;
+}
+
+/* Sommelier: when a top-level window shows a GPU client view over its client area, its child windows that draw
+ * with GDI (into the window surface, underneath) are listed for the Cocoa side to show above the view. */
+static void update_gdi_overlay(HWND toplevel)
+{
+    struct macdrv_win_data *data;
+    CGRect rects[64];
+    int count = 0;
+    HWND child;
+
+    if (!toplevel || !(data = get_win_data(toplevel))) return;
+    if (data->cocoa_window && data->client_view)
+    {
+        for (child = NtUserGetWindowRelative(toplevel, GW_CHILD); child && count < ARRAY_SIZE(rects);
+             child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+        {
+            RECT rect;
+            UINT dpi = NtUserGetWinMonitorDpi(child, MDT_RAW_DPI);
+
+            if (!(NtUserGetWindowLongW(child, GWL_STYLE) & WS_VISIBLE)) continue;
+            if (hwnd_has_client_surface(child)) continue;
+            NtUserGetClientRect(child, &rect, dpi);
+            NtUserMapWindowPoints(child, toplevel, (POINT *)&rect, 2, NtUserGetWinMonitorDpi(toplevel, MDT_RAW_DPI));
+            OffsetRect(&rect, data->rects.client.left - data->rects.visible.left,
+                       data->rects.client.top - data->rects.visible.top);
+            if (IsRectEmpty(&rect)) continue;
+            rects[count++] = cgrect_from_rect(rect);
+        }
+        TRACE("toplevel %p: %d GDI child rects over client view\n", toplevel, count);
+    }
+    if (data->cocoa_window) macdrv_window_set_gdi_overlay_rects(data->cocoa_window, rects, count);
+    release_win_data(data);
 }
 
