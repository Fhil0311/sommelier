+/* Modified by the Sommelier project, 2026: called with rawinput_mutex held, which it releases while the devices
+ * are opened and asked. Wine can suspend a thread inside a system call, where Windows cannot: a program that
+ * suspends a thread while it asks a device left every other thread waiting for the lock until it resumed it. */
 static void rawinput_update_device_list( BOOL force )
 {
     unsigned int ticks = NtGetTickCount();
     static unsigned int last_check;
+    struct list found = LIST_INIT( found );
     struct device *device, *next;
 
     TRACE( "\n" );
 
     if (ticks - last_check <= 2000 && !force) return;
     last_check = ticks;
+
