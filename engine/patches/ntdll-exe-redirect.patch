+/* Sommelier: a program Sommelier's recipes start in place of another (a game instead of its launcher). The table
+ * named by SOMMELIER_EXE_REDIRECTS has one "C:\Games\BL2<TAB>Launcher.exe<TAB>Borderlands2.exe" per line: the
+ * game's folder, the end of the launcher's path under it, and the program to start, relative to the launcher's
+ * folder (".." allowed). Paths compare without case. Read at each process creation, so a change needs no restart
+ * of the store that starts the programs. Returns the new image path (NT form) to use, or NULL. */
+static WCHAR *sommelier_redirect( const UNICODE_STRING *image )
+{
+    const char *table = getenv( "SOMMELIER_EXE_REDIRECTS" );
+    char line[2048], *path, *folder, *instead, *run, *end, *name, *target = NULL, *p;
+    WCHAR *ret = NULL;
+    size_t len, folder_len, instead_len, name_len;
+    FILE *f;
+
+    if (!table || !*table || !image->Buffer || !image->Length) return NULL;
+    if (!(f = fopen( table, "r" ))) return NULL;
+    len = image->Length / sizeof(WCHAR) * 3 + 1;
+    if (!(path = malloc( len ))) { fclose( f ); return NULL; }
+    len = ntdll_wcstoumbs( image->Buffer, image->Length / sizeof(WCHAR), path, len - 1, FALSE );
+    path[len] = 0;
+    name = path;
+    if (!strncmp( name, "\\??\\", 4 )) name += 4;
+    name_len = strlen( name );
+    while (!target && fgets( line, sizeof(line), f ))
+    {
+        folder = line;
+        if (!(instead = strchr( folder, '\t' ))) continue;
+        *instead++ = 0;
+        if (!(run = strchr( instead, '\t' ))) continue;
+        *run++ = 0;
+        if ((end = strpbrk( run, "\r\n" ))) *end = 0;
+        folder_len = strlen( folder );
+        instead_len = strlen( instead );
+        if (!folder_len || !instead_len || !*run) continue;
+        if (name_len < folder_len + 1 + instead_len) continue;
+        if (strncasecmp( name, folder, folder_len ) || name[folder_len] != '\\') continue;
+        if (name[name_len - instead_len - 1] != '\\' || strcasecmp( name + name_len - instead_len, instead )) continue;
+        /* the launcher's folder, then `run` on top of it, segment by segment */
+        if (!(target = malloc( name_len + strlen( run ) + 2 ))) break;
+        memcpy( target, name, name_len - instead_len - 1 );
+        target[name_len - instead_len - 1] = 0;
+        for (p = run; p && *p; )
+        {
+            char *next = strpbrk( p, "\\/" ), *seg_end = next ? next : p + strlen( p );
+            size_t seg = seg_end - p;
+            if (seg == 2 && !strncmp( p, "..", 2 ))
+            {
+                char *slash = strrchr( target, '\\' );
+                if (slash && slash > strchr( target, '\\' )) *slash = 0;   /* never above the drive's root */
+            }
+            else if (seg && !(seg == 1 && *p == '.'))
+            {
+                strcat( target, "\\" );
+                strncat( target, p, seg );
+            }
+            p = next ? next + 1 : NULL;
+        }
+    }
+    fclose( f );
+    free( path );
+    if (target)
+    {
+        len = strlen( target );
+        if ((ret = malloc( (len + 5) * sizeof(WCHAR) )))
+        {
+            size_t n = ntdll_umbstowcs( "\\??\\", 4, ret, 4 );
+            n += ntdll_umbstowcs( target, len, ret + n, len );
+            ret[n] = 0;
+        }
+        free( target );
+    }
+    return ret;
+}
