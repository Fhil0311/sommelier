//
// Signing. A build from this repository signs to run on this Mac only. The project's own builds sign with its
// Developer ID, so macOS keeps the permissions it gave (Screen Recording for clips) across rebuilds; that identity
// lives in Signing.local.xcconfig next to this file, which is not in the repository:
//
//     CODE_SIGN_IDENTITY = Developer ID Application
//     DEVELOPMENT_TEAM = <your team id>
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Signing.local.xcconfig"
